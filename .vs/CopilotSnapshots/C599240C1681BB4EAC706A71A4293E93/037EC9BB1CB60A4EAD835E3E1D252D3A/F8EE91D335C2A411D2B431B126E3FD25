/**
 * @fileoverview Custom Error Classes for StarMade HSQLDB Manager
 * 
 * This file defines a hierarchy of specialized error classes for different types of 
 * failures that can occur when working with StarMade HSQLDB databases. Each error 
 * class includes context-specific properties to aid in debugging and error handling.
 * 
 * @author InitSysRev
 * @version 1.0.0
 */

/**
 * @class HSQLDBError
 * @description The base error class for all custom errors in the library.
 * @extends {Error}
 */
export class HSQLDBError extends Error {
    /** 
     * A specific error code for programmatic identification of the error type.
     * @type {string} 
     */
    public code: string;
    
    /** 
     * The timestamp when the error occurred.
     * @type {Date} 
     * @readonly
     */
    public readonly timestamp: Date;
    
    /** 
     * An object containing additional context information about the error.
     * @type {Record<string, any> | undefined} 
     * @readonly
     */
    public readonly context?: Record<string, any>;
    
    /** 
     * A boolean indicating whether the error is potentially recoverable.
     * @type {boolean} 
     * @readonly
     */
    public readonly recoverable: boolean;
    
    /**
     * Creates an instance of HSQLDBError.
     * @param {string} message - The human-readable error message.
     * @param {string} code - The error code.
     * @param {boolean} [recoverable=false] - Whether the error is recoverable.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        message: string,
        code: string,
        recoverable: boolean = false,
        context?: Record<string, any>
    ) {
        super(message);
        this.name = this.constructor.name;
        this.code = code;
        this.timestamp = new Date();
        this.context = context;
        this.recoverable = recoverable;
        
        // Maintains proper stack trace for where our error was thrown (only available on V8)
        if (Error.captureStackTrace) {
            Error.captureStackTrace(this, this.constructor);
        }
    }
    
    /**
     * Gets a formatted error message that includes the error code and context.
     * @returns {string} The formatted error message.
     */
    getFormattedMessage(): string {
        let message = `[${this.code}] ${this.message}`;
        
        if (this.context && Object.keys(this.context).length > 0) {
            const contextStr = Object.entries(this.context)
                .map(([key, value]) => `${key}: ${value}`)
                .join(', ');
            message += ` (Context: ${contextStr})`;
        }
        
        return message;
    }
    
    /**
     * Converts the error object to a JSON representation for logging or serialization.
     * @returns {Record<string, any>} A JSON-serializable object representing the error.
     */
    toJSON(): Record<string, any> {
        return {
            name: this.name,
            message: this.message,
            code: this.code,
            timestamp: this.timestamp.toISOString(),
            context: this.context,
            recoverable: this.recoverable,
            stack: this.stack
        };
    }
}

// =============================================================================
// CONNECTION-RELATED ERRORS
// =============================================================================

/**
 * @class ConnectionError
 * @description Error thrown when a connection to the HSQLDB fails.
 * @extends {HSQLDBError}
 */
export class ConnectionError extends HSQLDBError {
    /**
     * Creates an instance of ConnectionError.
     * @param {string} message - The error message.
     * @param {Record<string, any>} [context] - Additional context.
     * @param {boolean} [recoverable=true] - Whether the error is recoverable.
     */
    constructor(
        message: string,
        context?: Record<string, any>,
        recoverable: boolean = true
    ) {
        super(message, 'CONNECTION_ERROR', recoverable, context);
    }
}

/**
 * @class ConnectionTimeoutError
 * @description Error thrown when a connection attempt times out.
 * @extends {ConnectionError}
 */
export class ConnectionTimeoutError extends ConnectionError {
    /** 
     * The timeout duration in milliseconds that was exceeded.
     * @type {number} 
     * @readonly
     */
    public readonly timeoutMs: number;
    
    /**
     * Creates an instance of ConnectionTimeoutError.
     * @param {number} timeoutMs - The timeout duration in milliseconds.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(timeoutMs: number, context?: Record<string, any>) {
        super(
            `Connection timed out after ${timeoutMs}ms`,
            { ...context, timeoutMs },
            true
        );
        this.timeoutMs = timeoutMs;
        this.code = 'CONNECTION_TIMEOUT';
    }
}

/**
 * @class ConnectionRetriesExhaustedError
 * @description Error thrown when the maximum number of connection retries is exceeded.
 * @extends {ConnectionError}
 */
export class ConnectionRetriesExhaustedError extends ConnectionError {
    /** 
     * The maximum number of retries that were attempted.
     * @type {number} 
     * @readonly
     */
    public readonly maxRetries: number;
    /** 
     * The last error that occurred before giving up.
     * @type {Error | undefined} 
     * @readonly
     */
    public readonly lastError?: Error;
    
    /**
     * Creates an instance of ConnectionRetriesExhaustedError.
     * @param {number} maxRetries - The maximum number of retries.
     * @param {Error} [lastError] - The last error encountered.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(maxRetries: number, lastError?: Error, context?: Record<string, any>) {
        super(
            `Failed to connect after ${maxRetries} retries`,
            { ...context, maxRetries, lastError: lastError?.message },
            false
        );
        this.maxRetries = maxRetries;
        this.lastError = lastError;
        this.code = 'CONNECTION_RETRIES_EXHAUSTED';
    }
}

/**
 * @class ConnectionLostError
 * @description Error thrown when an established connection is lost unexpectedly.
 * @extends {ConnectionError}
 */
export class ConnectionLostError extends ConnectionError {
    /** 
     * The reason for the connection loss, if known.
     * @type {string | undefined} 
     * @readonly
     */
    public readonly reason?: string;
    
    /**
     * Creates an instance of ConnectionLostError.
     * @param {string} [reason] - The reason for the connection loss.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(reason?: string, context?: Record<string, any>) {
        super(
            `Connection lost${reason ? `: ${reason}` : ''}`,
            { ...context, reason },
            true
        );
        this.reason = reason;
        this.code = 'CONNECTION_LOST';
    }
}

