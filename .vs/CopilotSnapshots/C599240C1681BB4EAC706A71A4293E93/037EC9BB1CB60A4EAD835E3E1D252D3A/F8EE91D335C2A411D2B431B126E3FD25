    /** 
     * The file system operation that failed (e.g., 'read', 'write').
     * @type {string} 
     * @readonly
     */
    public readonly operation: string;
    
    /**
     * Creates an instance of DatabaseFileError.
     * @param {string} filePath - The path to the problematic file.
     * @param {string} operation - The failed file system operation.
     * @param {string} [message] - An optional override for the error message.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        filePath: string,
        operation: string,
        message?: string,
        context?: Record<string, any>
    ) {
        super(
            message || `Failed to ${operation} database file: ${filePath}`,
            'DATABASE_FILE_ERROR',
            false,
            { ...context, filePath, operation }
        );
        this.filePath = filePath;
        this.operation = operation;
    }
}

