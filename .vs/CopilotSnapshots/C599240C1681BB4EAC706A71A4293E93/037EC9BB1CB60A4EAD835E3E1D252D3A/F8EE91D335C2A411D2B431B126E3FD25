 * @description Error thrown when database files are not accessible due to file system issues.
 * @extends {HSQLDBError}
 */
export class DatabaseFileError extends HSQLDBError {
    /** 
     * The path to the file that caused the error.
     * @type {string} 
     * @readonly
     */
