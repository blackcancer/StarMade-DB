/**
 * @class TransactionError
 * @description Error thrown when a database transaction operation fails.
 * @extends {HSQLDBError}
 */
export class TransactionError extends HSQLDBError {
    /** 
     * The ID of the transaction that failed.
     * @type {string} 
     * @readonly
     */
    public readonly transactionId: string;
    /** 
     * The transaction operation that failed (e.g., 'commit', 'rollback').
     * @type {string} 
     * @readonly
     */
    public readonly operation: string;
    
    /**
     * Creates an instance of TransactionError.
     * @param {string} transactionId - The ID of the transaction.
     * @param {string} operation - The failed transaction operation.
     * @param {string} message - The error message.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        transactionId: string,
        operation: string,
        message: string,
        context?: Record<string, any>
    ) {
        super(
            `Transaction ${operation} failed: ${message}`,
            'TRANSACTION_ERROR',
            true,
            { ...context, transactionId, operation }
        );
        this.transactionId = transactionId;
        this.operation = operation;
    }
}

/**
 * @class InactiveTransactionError
 * @description Error thrown when an operation is attempted on an inactive (committed or rolled back) transaction.
 * @extends {TransactionError}
 */
export class InactiveTransactionError extends TransactionError {
    /**
     * Creates an instance of InactiveTransactionError.
     * @param {string} transactionId - The ID of the inactive transaction.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(transactionId: string, context?: Record<string, any>) {
        super(
            transactionId,
            'access',
            `Transaction '${transactionId}' is not active`,
            context
        );
        this.code = 'INACTIVE_TRANSACTION';
    }
}

/**
 * @class TransactionDeadlockError
 * @description Error thrown when a transaction deadlock is detected.
 * @extends {TransactionError}
 */
export class TransactionDeadlockError extends TransactionError {
    /** 
     * A list of transaction IDs that are conflicting, if available.
     * @type {string[]} 
     * @readonly
     */
    public readonly conflictingTransactions: string[];
    
    /**
     * Creates an instance of TransactionDeadlockError.
     * @param {string} transactionId - The ID of the transaction that was a victim of the deadlock.
     * @param {string[]} [conflictingTransactions=[]] - The list of conflicting transaction IDs.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        transactionId: string,
        conflictingTransactions: string[] = [],
        context?: Record<string, any>
    ) {
        super(
            transactionId,
            'execute',
            'Transaction deadlock detected',
            { ...context, conflictingTransactions }
        );
        this.conflictingTransactions = conflictingTransactions;
        this.code = 'TRANSACTION_DEADLOCK';
    }
}

