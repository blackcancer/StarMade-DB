/**
 * @class ResourceLimitError
 * @description Error thrown when a resource limit (e.g., connections, memory) is exceeded.
 * @extends {HSQLDBError}
 */
export class ResourceLimitError extends HSQLDBError {
    /** 
     * The type of resource that was exhausted (e.g., 'Memory', 'Concurrent queries').
     * @type {string} 
     * @readonly
     */
    public readonly resourceType: string;
    /** 
     * The configured limit for the resource.
     * @type {number} 
     * @readonly
     */
    public readonly limit: number;
    /** 
     * The current usage count or value when the error occurred.
     * @type {number} 
     * @readonly
     */
    public readonly current: number;
    
    /**
     * Creates an instance of ResourceLimitError.
     * @param {string} resourceType - The type of the resource.
     * @param {number} limit - The configured limit.
     * @param {number} current - The current usage value.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        resourceType: string,
        limit: number,
        current: number,
        context?: Record<string, any>
    ) {
        super(
            `${resourceType} limit exceeded: ${current}/${limit}`,
            'RESOURCE_LIMIT_ERROR',
            true,
            { ...context, resourceType, limit, current }
        );
        this.resourceType = resourceType;
        this.limit = limit;
        this.current = current;
    }
}

/**
 * @class MemoryLimitError
 * @description Error thrown when memory usage exceeds a configured limit.
 * @extends {ResourceLimitError}
 */
export class MemoryLimitError extends ResourceLimitError {
    /**
     * Creates an instance of MemoryLimitError.
     * @param {number} limitMB - The memory limit in megabytes.
     * @param {number} currentMB - The current memory usage in megabytes.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(limitMB: number, currentMB: number, context?: Record<string, any>) {
        super('Memory', limitMB, currentMB, context);
        this.code = 'MEMORY_LIMIT_ERROR';
    }
}

/**
 * @class ConcurrentQueryLimitError
 * @description Error thrown when the limit for concurrent queries is exceeded.
 * @extends {ResourceLimitError}
 */
export class ConcurrentQueryLimitError extends ResourceLimitError {
    /**
     * Creates an instance of ConcurrentQueryLimitError.
     * @param {number} limit - The concurrent query limit.
     * @param {number} current - The number of queries running when the limit was hit.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(limit: number, current: number, context?: Record<string, any>) {
        super('Concurrent queries', limit, current, context);
        this.code = 'CONCURRENT_QUERY_LIMIT_ERROR';
    }
}

