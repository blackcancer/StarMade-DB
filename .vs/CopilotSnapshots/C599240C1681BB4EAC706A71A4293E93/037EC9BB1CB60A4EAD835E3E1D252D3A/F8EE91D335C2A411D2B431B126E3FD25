    /**
     * Creates an instance of WorldNotFoundError.
     * @param {string} worldName - The name of the world that was not found.
     * @param {string[]} [availableWorlds=[]] - The list of detected available worlds.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        worldName: string,
        availableWorlds: string[] = [],
        context?: Record<string, any>
    ) {
        super(
            `World '${worldName}' not found. Available worlds: ${availableWorlds.join(', ') || 'none'}`,
            ['worldName'],
            { ...context, worldName, availableWorlds }
        );
        this.worldName = worldName;
        this.availableWorlds = availableWorlds;
        this.code = 'WORLD_NOT_FOUND';
    }
}

