// =============================================================================
// QUERY-RELATED ERRORS
// =============================================================================

/**
 * @class QueryExecutionError
 * @description Error thrown when an SQL query execution fails.
 * @extends {HSQLDBError}
 */
export class QueryExecutionError extends HSQLDBError {
    /** 
     * The SQL query that failed.
     * @type {string} 
     * @readonly
     */
    public readonly query: string;
    /** 
     * The parameters used in the query, if any.
     * @type {any[] | undefined} 
     * @readonly
     */
    public readonly parameters?: any[];
    /** 
     * The SQLSTATE error code from the JDBC driver, if available.
     * @type {string | undefined} 
     * @readonly
     */
    public readonly sqlState?: string;
    /** 
     * The vendor-specific error code from the JDBC driver, if available.
     * @type {number | undefined} 
     * @readonly
     */
    public readonly errorCode?: number;
    
    /**
     * Creates an instance of QueryExecutionError.
     * @param {string} query - The SQL query that failed.
     * @param {string} message - The error message from the driver.
     * @param {any[]} [parameters] - The parameters used in the query.
     * @param {string} [sqlState] - The SQLSTATE code.
     * @param {number} [errorCode] - The vendor-specific error code.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        query: string,
        message: string,
        parameters?: any[],
        sqlState?: string,
        errorCode?: number,
        context?: Record<string, any>
    ) {
        super(
            `Query execution failed: ${message}`,
            'QUERY_EXECUTION_ERROR',
            true,
            { ...context, query, parameters, sqlState, errorCode }
        );
        this.query = query;
        this.parameters = parameters;
        this.sqlState = sqlState;
        this.errorCode = errorCode;
    }
}

/**
 * @class QueryTimeoutError
 * @description Error thrown when a query execution exceeds its time limit.
 * @extends {QueryExecutionError}
 */
export class QueryTimeoutError extends QueryExecutionError {
    /** 
     * The timeout duration in milliseconds that was exceeded.
     * @type {number} 
     * @readonly
     */
    public readonly timeoutMs: number;
    
    /**
     * Creates an instance of QueryTimeoutError.
     * @param {string} query - The query that timed out.
     * @param {number} timeoutMs - The timeout duration in milliseconds.
     * @param {any[]} [parameters] - The parameters used in the query.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        query: string,
        timeoutMs: number,
        parameters?: any[],
        context?: Record<string, any>
    ) {
        super(
            query,
            `Query timed out after ${timeoutMs}ms`,
            parameters,
            undefined,
            undefined,
            { ...context, timeoutMs }
        );
        this.timeoutMs = timeoutMs;
        this.code = 'QUERY_TIMEOUT';
    }
}

/**
 * @class SQLSyntaxError
 * @description Error thrown when an SQL query has invalid syntax.
 * @extends {QueryExecutionError}
 */
export class SQLSyntaxError extends QueryExecutionError {
    /** 
     * The character position of the syntax error, if available.
     * @type {number | undefined} 
     * @readonly
     */
    public readonly position?: number;
    
    /**
     * Creates an instance of SQLSyntaxError.
     * @param {string} query - The query with the syntax error.
     * @param {string} message - The error message from the parser.
     * @param {number} [position] - The position of the error.
     * @param {any[]} [parameters] - The parameters used in the query.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        query: string,
        message: string,
        position?: number,
        parameters?: any[],
        context?: Record<string, any>
    ) {
        super(
            query,
            `SQL syntax error: ${message}`,
            parameters,
            undefined,
            undefined,
            { ...context, position }
        );
        this.position = position;
        this.code = 'SQL_SYNTAX_ERROR';
    }
}

/**
 * @class SQLValidationError
 * @description Error thrown when an SQL query fails security or validation checks.
 * @extends {HSQLDBError}
 */
export class SQLValidationError extends HSQLDBError {
    /** 
     * The query that failed validation.
     * @type {string} 
     * @readonly
     */
    public readonly query: string;
    /** 
     * An array of validation errors found in the query.
     * @type {Array<{code: string; message: string; severity: 'info' | 'warning' | 'error' | 'critical'; position?: number; length?: number;}>} 
     * @readonly
     */
    public readonly validationErrors: Array<{
        code: string;
        message: string;
        severity: 'info' | 'warning' | 'error' | 'critical';
        position?: number;
        length?: number;
    }>;
    
    /**
     * Creates an instance of SQLValidationError.
     * @param {string} query - The query that failed validation.
     * @param {Array<object>} validationErrors - The list of validation errors.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        query: string,
        validationErrors: Array<{
            code: string;
            message: string;
            severity: 'info' | 'warning' | 'error' | 'critical';
            position?: number;
            length?: number;
        }>,
        context?: Record<string, any>
    ) {
        const errorMessages = validationErrors
            .filter(e => e.severity === 'error' || e.severity === 'critical')
            .map(e => e.message)
            .join('; ');
            
        super(
            `SQL validation failed: ${errorMessages}`,
            'SQL_VALIDATION_ERROR',
            false,
            { ...context, query, validationErrors }
        );
        this.query = query;
        this.validationErrors = validationErrors;
    }
}

/**
 * @class SQLInjectionError
 * @description Error thrown when a potential SQL injection attack is detected.
 * @extends {SQLValidationError}
 */
export class SQLInjectionError extends SQLValidationError {
    /** 
     * The type of SQL injection detected (e.g., 'tautology', 'union-based').
     * @type {string} 
     * @readonly
     */
    public readonly injectionType: string;
    /** 
     * A score indicating the assessed risk of the injection attempt.
     * @type {number} 
     * @readonly
     */
    public readonly riskScore: number;
    
    /**
     * Creates an instance of SQLInjectionError.
     * @param {string} query - The suspicious query.
     * @param {string} injectionType - The type of injection detected.
     * @param {number} riskScore - The assessed risk score.
     * @param {string} pattern - The specific pattern that was matched.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        query: string,
        injectionType: string,
        riskScore: number,
        pattern: string,
        context?: Record<string, any>
    ) {
        super(
            query,
            [{
                code: 'SQL_INJECTION_DETECTED',
                message: `SQL injection attempt detected: ${injectionType}`,
                severity: 'critical',
                position: query.indexOf(pattern)
            }],
            { ...context, injectionType, riskScore, pattern }
        );
        
        this.injectionType = injectionType;
        this.riskScore = riskScore;
        this.code = 'SQL_INJECTION_ERROR';
    }
}

