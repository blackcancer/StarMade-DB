// =============================================================================
// UTILITY FUNCTIONS
// =============================================================================

/**
 * A type guard to check if an error is an instance of HSQLDBError.
 * @param {any} error - The error to check.
 * @returns {error is HSQLDBError} True if the error is an HSQLDBError.
 */
export function isHSQLDBError(error: any): error is HSQLDBError {
    return error instanceof HSQLDBError;
}

/**
 * A type guard to check if an error is a recoverable HSQLDBError.
 * @param {any} error - The error to check.
 * @returns {boolean} True if the error is recoverable.
 */
export function isRecoverableError(error: any): boolean {
    return isHSQLDBError(error) && error.recoverable;
}

/**
 * Extracts structured error information from a native JDBC driver error.
 * @param {any} error - The raw error object from the JDBC driver.
 * @returns {{message: string; sqlState?: string; errorCode?: number; cause?: string;}} An object with structured error info.
 */
export function extractJDBCErrorInfo(error: any): {
    message: string;
    sqlState?: string;
    errorCode?: number;
    cause?: string;
} {
    // Handle nodejs-jdbc error format
    if (error && typeof error === 'object') {
        return {
            message: error.message || 'Unknown JDBC error',
            sqlState: error.sqlState,
            errorCode: error.errorCode || error.code,
            cause: error.cause?.message
        };
    }
    
    return {
        message: String(error || 'Unknown error')
    };
}

/**
 * Creates an appropriate HSQLDBError subclass based on a raw JDBC error.
 * @param {string} query - The SQL query that caused the error.
 * @param {any} jdbcError - The raw error from the JDBC driver.
 * @param {any[]} [parameters] - The parameters used in the query.
 * @param {Record<string, any>} [context] - Additional context.
 * @returns {HSQLDBError} A specific HSQLDBError instance.
 */
export function createErrorFromJDBC(
    query: string,
    jdbcError: any,
    parameters?: any[],
    context?: Record<string, any>
): HSQLDBError {
    const errorInfo = extractJDBCErrorInfo(jdbcError);
    
    // Check for specific error patterns
    if (errorInfo.message.toLowerCase().includes('timeout')) {
        return new QueryTimeoutError(query, 30000, parameters, context);
    }
    
    if (errorInfo.message.toLowerCase().includes('syntax')) {
        return new SQLSyntaxError(query, errorInfo.message, undefined, parameters, context);
    }
    
    if (errorInfo.message.toLowerCase().includes('deadlock')) {
        return new TransactionDeadlockError('unknown', [], context);
    }
    
    if (errorInfo.message.toLowerCase().includes('connection')) {
        return new ConnectionError(errorInfo.message, context);
    }
    
    // Default to generic query execution error
    return new QueryExecutionError(
        query,
        errorInfo.message,
        parameters,
        errorInfo.sqlState,
        errorInfo.errorCode,
        context
    );
}

/**
 * Formats an error for logging, using the custom format for HSQLDBError instances.
 * @param {Error} error - The error to format.
 * @returns {string} The formatted error message string.
 */
export function formatErrorForLogging(error: Error): string {
    if (isHSQLDBError(error)) {
        return error.getFormattedMessage();
    }
    
    return `[${error.constructor.name}] ${error.message}`;
}

/**
 * Gets a severity level for an error to assist in logging and monitoring.
 * @param {Error} error - The error to assess.
 * @returns {'low' | 'medium' | 'high' | 'critical'} The severity level of the error.
 */
export function getErrorSeverity(error: Error): 'low' | 'medium' | 'high' | 'critical' {
    if (!isHSQLDBError(error)) {
        return 'medium';
    }
    
    if (error instanceof ConfigurationError || error instanceof JavaEnvironmentError) {
        return 'critical';
    }
    
    if (error instanceof ConnectionError || error instanceof TransactionError) {
        return 'high';
    }
    
    if (error instanceof QueryExecutionError) {
        return error.recoverable ? 'medium' : 'high';
    }
    
    return 'medium';
}

// =============================================================================
// ERROR FACTORY
// =============================================================================

/**
 * @class ErrorFactory
 * @description A factory class for creating standardized error instances.
 */
export class ErrorFactory {
    /**
     * Creates a standardized ConnectionError.
     * @static
     * @param {string} message - The error message.
     * @param {string} [starmadeDir] - The StarMade directory path.
     * @param {string} [worldName] - The world name.
     * @param {Error} [cause] - The underlying cause of the error.
     * @returns {ConnectionError} A new ConnectionError instance.
     */
    static createConnectionError(
        message: string,
        starmadeDir?: string,
        worldName?: string,
        cause?: Error
    ): ConnectionError {
        return new ConnectionError(message, {
            starmadeDir,
            worldName,
            cause: cause?.message,
            timestamp: new Date().toISOString()
        });
    }
    
    /**
     * Creates a standardized QueryExecutionError from a raw JDBC error.
     * @static
     * @param {string} query - The SQL query that failed.
     * @param {any} error - The raw error from the JDBC driver.
     * @param {any[]} [parameters] - The parameters used in the query.
     * @param {number} [executionTimeMs] - The execution time of the query in milliseconds.
     * @returns {QueryExecutionError} A new QueryExecutionError instance.
     */
    static createQueryError(
        query: string,
        error: any,
        parameters?: any[],
        executionTimeMs?: number
    ): QueryExecutionError {
        const errorInfo = extractJDBCErrorInfo(error);
        
        return new QueryExecutionError(
            query,
            errorInfo.message,
            parameters,
            errorInfo.sqlState,
            errorInfo.errorCode,
            {
                executionTimeMs,
                timestamp: new Date().toISOString()
            }
        );
    }
    
    /**
     * Creates a standardized ConfigurationError, checking for missing required fields.
     * @static
     * @param {string} message - The error message.
     * @param {any} config - The configuration object being validated.
     * @param {string[]} requiredFields - A list of field names that are required in the config.
     * @returns {ConfigurationError} A new ConfigurationError instance.
     */
    static createConfigError(
        message: string,
        config: any,
        requiredFields: string[]
    ): ConfigurationError {
        const missingFields = requiredFields.filter(field => 
            !config || config[field] === undefined || config[field] === null
        );
        
        return new ConfigurationError(
            message,
            missingFields,
            {
                providedConfig: config,
                requiredFields,
                timestamp: new Date().toISOString()
            }
        );
    }
    
    /**
     * Creates a specialized SQLRequiredFieldError for missing required fields in any table.
     * @static
     * @param {string} tableName - The table involved in the operation.
     * @param {string} operation - The SQL operation that failed (INSERT, UPDATE, etc.).
     * @param {Partial<any>} data - The incomplete data.
     * @param {string[]} requiredFields - Array of required field names.
     * @returns {SQLRequiredFieldError} A new SQLRequiredFieldError instance.
     */
    static createSQLRequiredFieldError(
        tableName: string,
        operation: string,
        data: Partial<any>,
        requiredFields: string[]
    ): SQLRequiredFieldError {
        const missingFields = requiredFields.filter(field => {
            const value = data[field];
            return value === null || value === undefined;
        });
        
        return new SQLRequiredFieldError(
            tableName,
            operation,
            missingFields,
            data,
            {
                requiredFields,
                timestamp: new Date().toISOString()
            }
        );
    }
    
    /**
     * Creates a SQLConstraintViolationError from a database constraint error.
     * @static
     * @param {string} query - The SQL query that failed.
     * @param {any} error - The raw database error.
     * @param {string} tableName - The table involved in the violation.
     * @param {any} data - The data that caused the violation.
     * @returns {SQLConstraintViolationError} A new SQLConstraintViolationError instance.
     */
    static createSQLConstraintError(
        query: string,
        error: any,
        tableName: string,
        data: any
    ): SQLConstraintViolationError {
        const errorMessage = error.message || String(error);
        let constraintType: 'FOREIGN_KEY' | 'UNIQUE' | 'CHECK' | 'NOT_NULL' | 'PRIMARY_KEY' = 'CHECK';
        let constraintName = 'UNKNOWN';
        let violatedFields: string[] = [];
        
        // Parse HSQLDB constraint violation messages
        if (errorMessage.includes('foreign key no parent') || errorMessage.includes('integrity constraint violation: foreign key')) {
            constraintType = 'FOREIGN_KEY';
            // Extract constraint name if available
            const fkMatch = errorMessage.match(/([A-Z]+FK[A-Z]*|FFKC|EFKC)/i);
            if (fkMatch) {
                constraintName = fkMatch[1];
            }
            // Try to determine violated fields based on common patterns
            if (constraintName === 'FFKC' || errorMessage.includes('FLEET')) {
                violatedFields = ['FLEET_ID'];
            } else if (constraintName === 'EFKC' || errorMessage.includes('ENTIT')) {
                violatedFields = ['ENTITY_ID'];
            }
        } else if (errorMessage.includes('unique constraint') || errorMessage.includes('index violation') || errorMessage.includes('duplicate')) {
            constraintType = 'UNIQUE';
            // Extract constraint name if available
            const uniqueMatch = errorMessage.match(/constraint\s+([A-Z_]+)/i);
            if (uniqueMatch) {
                constraintName = uniqueMatch[1];
            }
            // Common unique constraint fields
            if (errorMessage.includes('UID')) {
                violatedFields = ['UID'];
            } else if (errorMessage.includes('PRIMARY')) {
                violatedFields = ['ID'];
            }
        } else if (errorMessage.includes('cannot be null') || errorMessage.includes('NOT NULL')) {
            constraintType = 'NOT_NULL';
            // Extract field name from error message if possible
            const nullFieldMatch = errorMessage.match(/Parameter (\d+) cannot be null/);
            if (nullFieldMatch) {
                const paramIndex = parseInt(nullFieldMatch[1]) - 1;
                // Common field order for StarMade tables - this is a best guess
                const commonFields = ['ID', 'FLEET_ID', 'ENTITY_ID', 'UID', 'X', 'Y', 'Z', 'TYPE'];
                violatedFields = [commonFields[paramIndex] || 'UNKNOWN_FIELD'];
            }
        } else if (errorMessage.includes('primary key') || errorMessage.includes('PRIMARY KEY')) {
            constraintType = 'PRIMARY_KEY';
            constraintName = 'PRIMARY_KEY';
            violatedFields = ['ID']; // Most tables use ID as primary key
        }
        
        return new SQLConstraintViolationError(
            query,
            constraintType,
            constraintName,
            tableName,
            violatedFields,
            data,
            errorMessage,
            {
                timestamp: new Date().toISOString()
            }
        );
    }
}

// =============================================================================
// ADVANCED SQL CONSTRAINT ERRORS
// =============================================================================

/**
 * @class SQLConstraintViolationError
 * @description Error thrown when SQL operations violate database constraints.
 * @extends {QueryExecutionError}
 */
export class SQLConstraintViolationError extends QueryExecutionError {
    /** 
     * The type of constraint that was violated.
     * @type {'FOREIGN_KEY' | 'UNIQUE' | 'CHECK' | 'NOT_NULL' | 'PRIMARY_KEY'} 
     * @readonly
     */
    public readonly constraintType: 'FOREIGN_KEY' | 'UNIQUE' | 'CHECK' | 'NOT_NULL' | 'PRIMARY_KEY';
    
    /** 
     * The name of the constraint that was violated.
     * @type {string} 
     * @readonly
     */
    public readonly constraintName: string;
    
    /** 
     * The table involved in the constraint violation.
     * @type {string} 
     * @readonly
     */
    public readonly tableName: string;
    
    /** 
     * The field(s) involved in the constraint violation.
     * @type {string[]} 
     * @readonly
     */
    public readonly violatedFields: string[];
    
    /** 
     * The data that caused the violation.
     * @type {any} 
     * @readonly
     */
    public readonly violatingData: any;
    
    /**
     * Creates an instance of SQLConstraintViolationError.
     * @param {string} query - The SQL query that failed.
     * @param {string} constraintType - The type of constraint violated.
     * @param {string} constraintName - The name of the constraint.
     * @param {string} tableName - The table involved in the violation.
     * @param {string[]} violatedFields - The fields involved in the violation.
     * @param {any} violatingData - The data that caused the violation.
     * @param {string} originalMessage - The original database error message.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        query: string,
        constraintType: 'FOREIGN_KEY' | 'UNIQUE' | 'CHECK' | 'NOT_NULL' | 'PRIMARY_KEY',
        constraintName: string,
        tableName: string,
        violatedFields: string[],
        violatingData: any,
        originalMessage: string,
        context?: Record<string, any>
    ) {
        let humanMessage = '';
        
        switch (constraintType) {
            case 'FOREIGN_KEY':
                humanMessage = `Foreign key constraint violation: Referenced record does not exist`;
                if (constraintName.includes('FK') || constraintName.includes('FFKC')) {
                    humanMessage += ` (constraint: ${constraintName})`;
                }
                break;
            case 'UNIQUE':
                humanMessage = `Unique constraint violation: Duplicate entry for unique field(s)`;
                break;
            case 'NOT_NULL':
                humanMessage = `Not null constraint violation: Required field(s) cannot be null`;
                break;
            case 'PRIMARY_KEY':
                humanMessage = `Primary key constraint violation: Duplicate or invalid primary key`;
                break;
            case 'CHECK':
                humanMessage = `Check constraint violation: Data does not meet constraint conditions`;
                break;
        }
        
        super(
            query,
            `SQL constraint violation in table ${tableName}: ${humanMessage}`,
            [],
            undefined,
            undefined,
            { 
                ...context, 
                constraintType, 
                constraintName, 
                tableName,
                violatedFields, 
                violatingData,
                originalMessage 
            }
        );
        
        this.constraintType = constraintType;
        this.constraintName = constraintName;
        this.tableName = tableName;
        this.violatedFields = violatedFields;
        this.violatingData = violatingData;
        this.code = 'SQL_CONSTRAINT_VIOLATION';
    }
    
    /**
     * Gets a user-friendly suggestion for fixing the constraint violation.
     * @returns {string} Suggestion for fixing the error.
     */
    getSuggestion(): string {
        switch (this.constraintType) {
            case 'FOREIGN_KEY':
                return 'Ensure that all referenced records exist in their parent tables before creating or updating this record.';
            case 'UNIQUE':
                return 'Check for duplicate entries and ensure unique values for the specified field(s).';
            case 'NOT_NULL':
                return 'Provide values for all required fields that cannot be null.';
            case 'PRIMARY_KEY':
                return 'Ensure primary key values are unique and not null.';
            case 'CHECK':
                return 'Review data values to ensure they meet all defined constraint conditions.';
            default:
                return 'Review the data and ensure it meets all table constraints.';
        }
    }
    
    /**
     * Gets a detailed error message with specific field and constraint information.
     * @returns {string} Detailed error message.
     */
    getDetailedMessage(): string {
        let message = this.getFormattedMessage();
        
        message += `\n\nConstraint Details:`;
        message += `\n- Type: ${this.constraintType}`;
        message += `\n- Constraint Name: ${this.constraintName}`;
        message += `\n- Table: ${this.tableName}`;
        message += `\n- Affected Fields: ${this.violatedFields.join(', ')}`;
        message += `\n- Suggestion: ${this.getSuggestion()}`;
        
        if (this.violatingData && typeof this.violatingData === 'object') {
            const relevantData = this.violatedFields.reduce((acc, field) => {
                if (this.violatingData[field] !== undefined) {
                    acc[field] = this.violatingData[field];
                }
                return acc;
            }, {} as Record<string, any>);
            
            if (Object.keys(relevantData).length > 0) {
                message += `\n- Violating Data: ${JSON.stringify(relevantData)}`;
            }
        }
        
        return message;
    }
}

/**
 * @class SQLRequiredFieldError
 * @description Error thrown when required fields are missing during SQL operations.
 * @extends {ValidationError}
 */
export class SQLRequiredFieldError extends ValidationError {
    /** 
     * Array of missing required field names.
     * @type {string[]} 
     * @readonly
     */
    public readonly missingFields: string[];
    
    /** 
     * The table involved in the operation.
     * @type {string} 
     * @readonly
     */
    public readonly tableName: string;
    
    /** 
     * The SQL operation that failed (INSERT, UPDATE, etc.).
     * @type {string} 
     * @readonly
     */
    public readonly operation: string;
    
    /**
     * Creates an instance of SQLRequiredFieldError.
     * @param {string} tableName - The table involved in the operation.
     * @param {string} operation - The SQL operation that failed.
     * @param {string[]} missingFields - Array of missing required field names.
     * @param {any} providedData - The incomplete data that was provided.
     * @param {Record<string, any>} [context] - Additional context.
     */
    constructor(
        tableName: string,
        operation: string,
        missingFields: string[],
        providedData: any,
        context?: Record<string, any>
    ) {
        const fieldList = missingFields.join(', ');
        const message = `${operation} operation failed on table ${tableName}: Missing required fields [${fieldList}]`;
        
        super(
            `${tableName}.requiredFields`,
            providedData,
            `Required fields missing: ${fieldList}`,
            message,
            { ...context, tableName, operation, missingFields, providedData }
        );
        
        this.missingFields = missingFields;
        this.tableName = tableName;
        this.operation = operation;
        this.code = 'SQL_REQUIRED_FIELD_ERROR';
    }
    
    /**
     * Gets a detailed error message with field requirements.
     * @returns {string} Detailed error message.
     */
    getDetailedMessage(): string {
        let message = this.getFormattedMessage();
        
        message += `\n\nMissing Required Fields for ${this.tableName}:`;
        for (const field of this.missingFields) {
            message += `\n- ${field}: Value required for ${this.operation} operation`;
        }
        
        message += `\n\nSuggestion: Provide values for all required fields before attempting the ${this.operation} operation.`;
        
        return message;
    }
}