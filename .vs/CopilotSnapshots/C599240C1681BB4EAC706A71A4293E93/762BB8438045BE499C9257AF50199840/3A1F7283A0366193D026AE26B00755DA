                expect(savepoint).to.include('sp_v2_'); // Custom prefix
                
                await transaction.rollback('Custom config test cleanup');
                
            } finally {
                await customManager.destroy();
            }
        });

        it('should support transaction options inheritance in v2.0', async function() {
            const parentOptions: TransactionOptions = {
                isolationLevel: IsolationLevel.REPEATABLE_READ,
                timeout: 25000,
                maxRetries: 2,
                enableLogging: true
            };
            
            const result = await transactionManager.executeTransaction(async (ctx) => {
                const state = ctx.getState();
                expect(state.isolationLevel).to.equal(IsolationLevel.REPEATABLE_READ);
                
                await createTestTable(ctx);
                await ctx.execute('INSERT INTO TEST_TRANSACTIONS (id, value) VALUES (?, ?)', [600, 'inheritance_test_v2']);
                
                return { inherited: true, isolationLevel: state.isolationLevel };
            }, parentOptions);
            
            expect(result.inherited).to.be.true;
            expect(result.isolationLevel).to.equal(IsolationLevel.REPEATABLE_READ);
        });

        it('should handle v2.0 configuration validation', function() {
            // Test valid configurations
            const validConfigs = [
                { maxConcurrentTransactions: 1 },
                { maxConcurrentTransactions: 100 },
                { defaultTimeout: 1000 },
                { defaultTimeout: 300000 },
                { deadlockDetectionInterval: 1000 }
            ];
            
            for (const config of validConfigs) {
                expect(() => new TransactionManager(config)).to.not.throw();
            }
        });
    });

    describe('v2.0 Error Recovery and Resilience', function() {
        it('should recover from connection issues in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
            try {
                await createTestTable(transaction);
                
                // Simulate some database operations
                await transaction.execute('INSERT INTO TEST_TRANSACTIONS (id, value) VALUES (?, ?)', [700, 'recovery_test_v2']);
                
                // v2.0 should handle connection issues gracefully
                const result = await transaction.query('SELECT * FROM TEST_TRANSACTIONS WHERE id = 700');
                expect(result).to.have.length(1);
                
                await transaction.rollback('Recovery test cleanup');
                
            } catch (error) {
                await transaction.rollback('Recovery test failed');
                throw error;
            }
        });

        it('should handle v2.0 cleanup on unexpected errors', async function() {
            const initialCount = transactionManager.getActiveTransactionCount();
            
            try {
                await transactionManager.executeTransaction(async (ctx) => {
                    await createTestTable(ctx);
                    
                    // Force an unexpected error
