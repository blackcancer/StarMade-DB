        it('should maintain v2.0 consistency under stress', async function() {
            const stressOperations = [];
            const operationCount = 20; // Reduced for v2.0 stability
            
            for (let i = 0; i < operationCount; i++) {
                stressOperations.push(
                    transactionManager.executeTransaction(async (ctx) => {
                        await ctx.execute('SELECT 1 FROM INFORMATION_SCHEMA.SYSTEM_USERS LIMIT 1');
                        
                        if (i % 5 === 0) {
                            // Occasionally fail to test error handling
                            throw new Error(`Stress test failure ${i}`);
                        }
                        
                        return { operationId: i, success: true };
                    }).catch(error => {
                        return { operationId: i, success: false, error: error.message };
                    })
                );
            }
            
            const results = await Promise.all(stressOperations);
            
            expect(results).to.have.length(operationCount);
            
            const successful = results.filter(r => r.success).length;
            const failed = results.filter(r => !r.success).length;
            
            console.log(`v2.0 Stress test: ${successful} successful, ${failed} failed operations`);
            
            expect(successful).to.be.greaterThan(0);
            expect(failed).to.be.greaterThan(0); // Some should fail intentionally
            expect(transactionManager.getActiveTransactionCount()).to.equal(0); // All should be cleaned up
        });
    });

