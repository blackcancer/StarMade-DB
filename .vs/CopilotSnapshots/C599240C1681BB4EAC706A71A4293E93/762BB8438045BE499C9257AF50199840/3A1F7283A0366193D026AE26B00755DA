                // Phase 3: Nested savepoint
                const savepoint2 = await transaction.createSavepoint('phase3_v2');
                await transaction.execute('INSERT INTO TEST_TRANSACTIONS (id, value) VALUES (?, ?)', [802, 'phase3_v2']);
                
                // Verify data
