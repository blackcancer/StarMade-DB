            expect(transaction1.getTransactionId()).to.include('tx_v2_'); // UPDATED: v2.0 format
            expect(transaction2.getTransactionId()).to.include('tx_v2_'); // UPDATED: v2.0 format
            
            await transaction1.rollback('Test cleanup');
            await transaction2.rollback('Test cleanup');
        });

        it('should allow custom transaction IDs in v2.0', async function() {
            const customId = 'custom-transaction-id-12345';
