        it('should enforce v2.0 maximum concurrent transaction limit', async function() {
            // Create a manager with very low limit for v2.0
            const limitedConfig: TransactionConfig = {
                maxConcurrentTransactions: 2
            };
            
            const limitedManager = new TransactionManager(limitedConfig);
            await limitedManager.initialize(manager);
            
            const transactions: TransactionContext[] = [];
            
            try {
                // Create transactions up to limit
                for (let i = 0; i < 2; i++) {
                    const tx = await limitedManager.beginTransaction();
                    transactions.push(tx);
                }
                
                // Next transaction should fail
                try {
                    await limitedManager.beginTransaction();
                    expect.fail('Should have thrown an error for exceeding limit');
                } catch (error: unknown) {
                    expect(error).to.be.instanceOf(ModuleError);
                    expect((error as Error).message).to.include('Maximum concurrent transactions exceeded');
                }
                
            } finally {
                // Clean up
                for (const tx of transactions) {
                    try {
                        await tx.rollback('Test cleanup');
                    } catch (error) {
                        // Ignore cleanup errors
                    }
                }
                await limitedManager.destroy();
            }
        });

        it('should handle v2.0 simplified connection management', async function() {
            // Test that v2.0 uses direct connection management without sessions
            const transaction = await transactionManager.beginTransaction();
            
            try {
                await createTestTable(transaction);
                
                // In v2.0, connections are managed directly without session tracking
                const connection = transaction.getConnection();
                expect(connection).to.exist;
                
                // Transaction should be tracked in active transactions
                const activeCount = transactionManager.getActiveTransactionCount();
                expect(activeCount).to.be.greaterThan(0);
                
                await transaction.rollback('Test cleanup');
                
                // After rollback, transaction should be cleaned up
                const finalCount = transactionManager.getActiveTransactionCount();
                expect(finalCount).to.be.lessThan(activeCount);
                
            } catch (error) {
                await transaction.rollback('Test failed');
                throw error;
            }
        });
    });

    describe('Enhanced Error Handling v2.0', function() {
        it('should handle operations before initialization in v2.0', async function() {
            const testManager = new TransactionManager();
            
            try {
                await testManager.beginTransaction();
                expect.fail('Should have thrown an error');
            } catch (error: unknown) {
                expect(error).to.be.instanceOf(ModuleError);
                expect((error as Error).message).to.include('not initialized');
            }
        });

        it('should handle invalid transaction operations in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
            try {
                await transaction.commit();
                
                // Operations after commit should fail
                try {
                    await transaction.execute('SELECT 1');
                    expect.fail('Should have thrown an error');
                } catch (error: unknown) {
                    expect(error).to.be.instanceOf(ModuleError);
                    expect((error as Error).message).to.include('Transaction context destroyed');
                }
                
            } catch (error) {
                await transaction.rollback('Test failed');
                throw error;
            }
        });

        it('should handle non-existent transaction operations in v2.0', async function() {
            try {
                await transactionManager.commitTransaction('non-existent-tx-id');
                expect.fail('Should have thrown an error');
            } catch (error: unknown) {
                expect(error).to.be.instanceOf(InactiveTransactionError);
            }
            
            try {
                await transactionManager.rollbackTransaction('non-existent-tx-id');
