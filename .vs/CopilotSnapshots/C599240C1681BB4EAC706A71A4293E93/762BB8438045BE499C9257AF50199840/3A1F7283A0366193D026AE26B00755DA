            expect(transaction.getTransactionId()).to.equal(customId);
            
            await transaction.rollback('Test cleanup');
        });

        it('should handle concurrent transactions within limits in v2.0', async function() {
            const maxConcurrent = 5;
            const transactions: TransactionContext[] = [];
            
            try {
                // Create multiple concurrent transactions
                for (let i = 0; i < maxConcurrent; i++) {
                    const tx = await transactionManager.beginTransaction();
                    transactions.push(tx);
                }
                
                expect(transactionManager.getActiveTransactionCount()).to.equal(maxConcurrent);
                
            } finally {
