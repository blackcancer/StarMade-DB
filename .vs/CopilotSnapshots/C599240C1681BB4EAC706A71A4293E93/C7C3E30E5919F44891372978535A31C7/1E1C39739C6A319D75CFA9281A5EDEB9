/**
 * @class ModuleRegistry
 * @description A static registry for tracking and creating available modules.
 */
export class ModuleRegistry {
    /**
     * @private
     * @static
     * @readonly
     * @type {Map<string, new () => BaseModule>}
     * @description The internal map storing module constructors.
     */
    private static readonly registry: Map<string, new () => BaseModule> = new Map();

    /**
     * Registers a module constructor in the registry.
     * @static
     * @param {string} name - The name to register the module under.
     * @param {new () => BaseModule} moduleConstructor - The constructor of the module.
     */
    public static register(name: string, moduleConstructor: new () => BaseModule): void {
        this.registry.set(name, moduleConstructor);
    }

    /**
     * Creates a new instance of a module from the registry.
     * @static
     * @param {string} name - The name of the module to create.
     * @returns {BaseModule | undefined} A new module instance, or undefined if not found.
     */
    public static create(name: string): BaseModule | undefined {
        const Constructor = this.registry.get(name);
        return Constructor ? new Constructor() : undefined;
    }

    /**
     * Gets a list of all registered module names.
     * @static
     * @returns {string[]} An array of registered module names.
     */
    public static getRegisteredModules(): string[] {
        return Array.from(this.registry.keys());
    }
}