/**
 * @fileoverview StarMade HSQLDB Manager
 * 
 * Main manager class for handling StarMade HSQLDB database operations
 * with a modular architecture for extensibility and maintainability.
 * 
 * @author InitSysRev
 * @version 1.0.0
 */

import { resourceCleaner, validateStarMadeDirectory, generateDatabaseUrl, detectAvailableWorlds } from './utils.js';
import { 
    ConfigurationError, 
    WorldNotFoundError, 
    HSQLDBError, 
    ErrorFactory,
    ModuleAlreadyRegisteredError,
    ManagerDestroyedError,
    InvalidManagerStateError
} from './errors.js';
import { createModuleLogger, initializeLogger, DEFAULT_CONFIGS, type ModuleLogger, type LoggerConfig } from './modules/logging/Logger.js';

// =============================================================================
// CONFIGURATION INTERFACES
// =============================================================================

/**
 * Configuration for individual modules
 */
export interface ModuleConfiguration {
    /** Enable relationship analysis module */
    enableRelationshipAnalysis?: boolean;
    /** Enable query validation module */
    enableQueryValidation?: boolean;
    /** Enable parameterized queries module */
    enableParameterizedQueries?: boolean;
    /** Enable advanced caching module */
    enableAdvancedCaching?: boolean;
    /** Enable metrics collection module */
    enableMetricsCollection?: boolean;
    /** Enable auto-reconnection module */
    enableAutoReconnection?: boolean;
    /** Enable connection factory module */
    enableConnectionFactory?: boolean;
}

/**
 * Connection-specific configuration
 */
export interface ConnectionConfiguration {
    /** Connection timeout in milliseconds */
    timeoutMs?: number;
    /** Maximum number of connection retries */
    maxRetries?: number;
    /** Read-only connection mode */
    readOnly?: boolean;
    /** Auto-commit transactions */
    autoCommit?: boolean;
    /** Maximum concurrent connections */
    maxConcurrentConnections?: number;
}

/**
 * Performance-related configuration
 */
export interface PerformanceConfiguration {
    /** Enable caching */
    enableCaching?: boolean;
    /** Cache size (number of entries) */
    cacheSize?: number;
    /** Cache TTL in milliseconds */
    cacheTtlMs?: number;
    /** Maximum concurrent queries */
    maxConcurrentQueries?: number;
    /** Query timeout in milliseconds */
    queryTimeoutMs?: number;
}

/**
 * Logging configuration - extends Winston LoggerConfig
 */
export interface LoggingConfiguration extends Partial<LoggerConfig> {
    /** Log level */
    logLevel?: 'debug' | 'info' | 'warn' | 'error';
    /** Log queries */
    logQueries?: boolean;
    /** Log connections */
    logConnections?: boolean;
    /** Log performance metrics */
    logPerformance?: boolean;
}

/**
 * Security configuration
 */
export interface SecurityConfiguration {
    /** Enable query security validation */
    enableQuerySecurity?: boolean;
    /** Allowed SQL operations */
    allowedOperations?: ('SELECT' | 'INSERT' | 'UPDATE' | 'DELETE' | 'CREATE' | 'DROP' | 'ALTER')[];
    /** Enable parameter sanitization */
    enableParameterSanitization?: boolean;
    /** Maximum query complexity */
    maxQueryComplexity?: number;
}

/**
 * Database-specific configuration for HSQLDB
 */
export interface DatabaseConfiguration {
    /** Stability mode for test environments */
    stabilityMode?: boolean;
    /** Disable HSQLDB lock file (.lck) - CRITICAL for test stability */
    disableLockFile?: boolean;
    /** Fast mode for tests */
    fastMode?: boolean;
    /** Memory optimized mode */
    memoryOptimized?: boolean;
}

/**
 * Main configuration interface for HSQLManager
 */
export interface HSQLManagerConfiguration {
    /** Path to StarMade installation directory */
    starmadeDir: string;
    /** Name of the world/database to connect to */
    worldName: string;
    /** Module configuration */
    modules?: ModuleConfiguration;
    /** Connection configuration */
    connection?: ConnectionConfiguration;
    /** Performance configuration */
    performance?: PerformanceConfiguration;
    /** Logging configuration */
    logging?: LoggingConfiguration;
    /** Security configuration */
    security?: SecurityConfiguration;
    /** Database-specific configuration */
    database?: DatabaseConfiguration;
}

/**
 * Default configuration values
 */
export const DEFAULT_CONFIG: Required<Omit<HSQLManagerConfiguration, 'starmadeDir' | 'worldName'>> = {
    modules: {
        enableRelationshipAnalysis: true,
        enableQueryValidation: true,
        enableParameterizedQueries: true,
        enableAdvancedCaching: true,
        enableMetricsCollection: true,
        enableAutoReconnection: true,
        enableConnectionFactory: true
    },
    connection: {
        timeoutMs: 30000,
        maxRetries: 3,
        readOnly: true,
        autoCommit: true,
        maxConcurrentConnections: 10
    },
    performance: {
        enableCaching: true,
        cacheSize: 1000,
        cacheTtlMs: 300000, // 5 minutes
        maxConcurrentQueries: 10,
        queryTimeoutMs: 30000
    },
    logging: {
        level: 'info',
        enableConsole: true,
        enableFile: false,
        enableQueries: false,
        enableConnections: true,
        enablePerformance: true,
        logLevel: 'info', // Winston LoggerConfig compatibility
        logQueries: false, // HSQLManager specific
        logConnections: true, // HSQLManager specific
        logPerformance: true // HSQLManager specific
    },
    security: {
        enableQuerySecurity: true,
        allowedOperations: ['SELECT'],
        enableParameterSanitization: true,
        maxQueryComplexity: 10
    },
    database: {
        stabilityMode: false,
        disableLockFile: false,
        fastMode: false,
        memoryOptimized: false
    }
};

// =============================================================================
// MANAGER STATES AND INTERFACES
// =============================================================================

/**
 * Manager state enumeration
 */
export enum ManagerState {
    UNINITIALIZED = 'uninitialized',
    INITIALIZING = 'initializing',
    READY = 'ready',
    CONNECTING = 'connecting',
    CONNECTED = 'connected',
    DISCONNECTING = 'disconnecting',
    DISCONNECTED = 'disconnected',
    ERROR = 'error',
    DESTROYED = 'destroyed'
}

/**
 * Manager status information
 */
export interface ManagerStatus {
    state: ManagerState;
    isReady: boolean;
    isConnected: boolean;
    lastError?: HSQLDBError;
    connectionCount: number;
    uptime: number;
    modulesLoaded: string[];
}

/**
 * Base interface for all modules
 */
export interface BaseModule {
    /** Module name */
    readonly name: string;
    /** Module version */
    readonly version: string;
    /** Whether module is initialized */
    readonly isInitialized: boolean;
    /** Initialize the module */
    initialize(manager: HSQLManager): Promise<void>;
    /** Destroy the module and cleanup resources */
    destroy(): Promise<void>;
}

// =============================================================================
// MAIN HSQL MANAGER CLASS
// =============================================================================

/**
 * @class HSQLManager
 * @description Provides centralized management of HSQLDB connections and operations
 * for StarMade databases with a modular architecture.
 */
export class HSQLManager {
    /**
     * @private
     * @readonly
     * @type {Required<HSQLManagerConfiguration>}
     * @description The fully merged and validated configuration for the manager.
     */
    private readonly config: Required<HSQLManagerConfiguration>;

    /**
     * @private
     * @type {ManagerState}
     * @description The current operational state of the manager.
     */
    private state: ManagerState = ManagerState.UNINITIALIZED;

    /**
     * @private
     * @readonly
     * @type {Map<string, BaseModule>}
     * @description A map of all registered modules, keyed by their names.
     */
    private readonly modules: Map<string, BaseModule> = new Map();

    /**
     * @private
     * @readonly
     * @type {number}
     * @description The timestamp when the manager instance was created.
     */
    private readonly startTime: number = Date.now();

    /**
     * @private
     * @type {HSQLDBError | undefined}
     * @description The last error that occurred in the manager.
     */
    private lastError?: HSQLDBError;

    /**
     * @private
     * @type {number}
     * @description The current number of active connections.
     */
    private connectionCount: number = 0;

    /**
     * @private
     * @type {boolean}
     * @description Flag indicating if the manager has been destroyed.
     */
    private destroyed: boolean = false;

    /**
     * @private
     * @type {ModuleLogger}
     * @description The logger instance for the manager.
     */
    private logger!: ModuleLogger; // Use definite assignment assertion

    /**
     * @private
     * @type {boolean}
     * @description Flag indicating if the logger has been successfully initialized.
     */
    private loggerInitialized: boolean = false;

    /**
     * Creates a new HSQLManager instance.
     * @param {HSQLManagerConfiguration} config - The configuration for the manager.
     */
    constructor(config: HSQLManagerConfiguration) {
        this.config = this.mergeWithDefaults(config);
        this.validateConfiguration();
        
        // Initialize logging system
        this.initializeLogging();
        
        // Register for cleanup
        resourceCleaner.register(this);
        
        this.logger.info('HSQLManager created', {
            operation: 'constructor',
            starmadeDir: this.config.starmadeDir,
            worldName: this.config.worldName
        });
    }

    /**
     * Initializes the logging system using the provided configuration.
     * Falls back to a basic console logger if initialization fails.
     * @private
     */
    private initializeLogging(): void {
        try {
            // Create logger configuration from manager config
            const loggerConfig: LoggerConfig = {
                level: this.config.logging.level || 'info',
                enableConsole: this.config.logging.enableConsole ?? true,
                enableFile: this.config.logging.enableFile ?? false,
                enableQueries: this.config.logging.enableQueries ?? false,
                enableConnections: this.config.logging.enableConnections ?? true,
                enablePerformance: this.config.logging.enablePerformance ?? true,
                logDir: this.config.logging.logDir,
                maxFiles: this.config.logging.maxFiles,
                maxSize: this.config.logging.maxSize
            };
            
            // Initialize global logger if not already done
            initializeLogger(loggerConfig);
            
            // Create module logger
            this.logger = createModuleLogger('HSQLManager');
            this.loggerInitialized = true;
            
        } catch (error) {
            // Fallback to console logging if Winston fails
            this.loggerInitialized = false;
            console.warn('Failed to initialize Winston logger, falling back to console logging:', error);
            // Create a minimal fallback logger
            this.logger = {
                error: (msg: string, ctx?: any) => console.error(`[HSQLManager] ERROR: ${msg}`, ctx),
                warn: (msg: string, ctx?: any) => console.warn(`[HSQLManager] WARN: ${msg}`, ctx),
                info: (msg: string, ctx?: any) => console.info(`[HSQLManager] INFO: ${msg}`, ctx),
                debug: (msg: string, ctx?: any) => console.debug(`[HSQLManager] DEBUG: ${msg}`, ctx),
                query: (sql: string, time: number, ctx?: any) => console.log(`[HSQLManager] QUERY: ${sql} (${time}ms)`, ctx),
                connection: (event: string, id: string, ctx?: any) => console.log(`[HSQLManager] CONNECTION: ${event} ${id}`, ctx),
                performance: (metric: string, value: number, ctx?: any) => console.log(`[HSQLManager] PERFORMANCE: ${metric}=${value}`, ctx)
            } as ModuleLogger;
        }
    }

    /**
     * Merges the user-provided configuration with default values.
     * @private
     * @param {HSQLManagerConfiguration} config - The user-provided configuration.
     * @returns {Required<HSQLManagerConfiguration>} The fully merged configuration.
     */
    private mergeWithDefaults(config: HSQLManagerConfiguration): Required<HSQLManagerConfiguration> {
        return {
            starmadeDir: config.starmadeDir,
            worldName: config.worldName,
            modules: { ...DEFAULT_CONFIG.modules, ...config.modules },
            connection: { ...DEFAULT_CONFIG.connection, ...config.connection },
            performance: { ...DEFAULT_CONFIG.performance, ...config.performance },
            logging: { ...DEFAULT_CONFIG.logging, ...config.logging },
            security: { ...DEFAULT_CONFIG.security, ...config.security },
            database: { ...DEFAULT_CONFIG.database, ...config.database }
        };
    }

    /**
     * Validates the essential parts of the configuration.
     * @private
     * @throws {ConfigurationError} If the configuration is invalid.
     */
    private validateConfiguration(): void {
        if (!this.config.starmadeDir) {
            throw ErrorFactory.createConfigError(
                'StarMade directory is required',
                this.config,
                ['starmadeDir']
            );
        }

        if (!this.config.worldName) {
            throw ErrorFactory.createConfigError(
                'World name is required',
                this.config,
                ['worldName']
            );
        }

        // Validate StarMade directory exists
        try {
            validateStarMadeDirectory(this.config.starmadeDir);
        } catch (error) {
            throw new ConfigurationError(
                `Invalid StarMade directory: ${error instanceof Error ? error.message : String(error)}`,
                ['starmadeDir'],
                { starmadeDir: this.config.starmadeDir }
            );
        }
    }

    /**
     * Initializes the manager, validates the world, and loads all configured modules.
     * @async
     * @returns {Promise<void>} A promise that resolves when initialization is complete.
     * @throws {ManagerDestroyedError} If the manager has already been destroyed.
     * @throws {InvalidManagerStateError} If the manager is not in the UNINITIALIZED state.
     * @throws {HSQLDBError} If initialization fails for any reason.
     */
    public async initialize(): Promise<void> {
        if (this.destroyed) {
            throw new ManagerDestroyedError('initialize', {
                operation: 'initialize'
            });
        }
        
        if (this.state !== ManagerState.UNINITIALIZED) {
            throw new InvalidManagerStateError(
                'initialize',
                this.state,
                [ManagerState.UNINITIALIZED],
                { operation: 'initialize' }
            );
        }

        this.state = ManagerState.INITIALIZING;
        this.logger.info('Starting HSQLManager initialization', {
            operation: 'initialize'
        });

        try {
            // Validate world exists
            await this.validateWorld();
            
            // Initialize modules based on configuration
            await this.initializeModules();
            
            this.state = ManagerState.READY;
            this.logger.info('HSQLManager initialized successfully', {
                operation: 'initialize-complete',
                modulesLoaded: this.modules.size,
                uptime: Date.now() - this.startTime
            });
            
        } catch (error) {
            this.state = ManagerState.ERROR;
            this.lastError = error instanceof HSQLDBError ? error :
                new ConfigurationError(`Initialization failed: ${error instanceof Error ? error.message : String(error)}`);
            
            this.logger.error('HSQLManager initialization failed', {
                operation: 'initialize-error',
                error: this.lastError.message,
                errorCode: this.lastError.code
            });
            
            throw this.lastError;
        }
    }

    /**
     * Validates that the specified world exists within the StarMade directory.
     * @private
     * @async
     * @returns {Promise<void>} A promise that resolves if the world is valid.
     * @throws {WorldNotFoundError} If the specified world does not exist.
     * @throws {ConfigurationError} If there's an issue detecting available worlds.
     */
    private async validateWorld(): Promise<void> {
        this.logger.debug('Validating world existence', {
            operation: 'validate-world',
            worldName: this.config.worldName,
            starmadeDir: this.config.starmadeDir
        });
        
        try {
            const availableWorlds = await detectAvailableWorlds(this.config.starmadeDir);
            
            this.logger.debug('Available worlds detected', {
                operation: 'detect-worlds',
                availableWorlds,
                requestedWorld: this.config.worldName
            });
            
            if (!availableWorlds.includes(this.config.worldName)) {
                throw new WorldNotFoundError(this.config.worldName, availableWorlds);
            }
            
            this.logger.info('World validation successful', {
                operation: 'validate-world-success',
                worldName: this.config.worldName
            });
        } catch (error) {
            if (error instanceof WorldNotFoundError) {
                this.logger.error('World not found', {
                    operation: 'validate-world-error',
                    worldName: this.config.worldName,
                    availableWorlds: error.availableWorlds
                });
                throw error;
            }
            throw new ConfigurationError(
                `Failed to validate world: ${error instanceof Error ? error.message : String(error)}`
            );
        }
    }

    /**
     * Dynamically imports and initializes all modules enabled in the configuration.
     * Modules are initialized in a specific order to handle dependencies.
     * @private
     * @async
     * @returns {Promise<void>} A promise that resolves when all modules are initialized.
     * @throws {Error} If a critical module (like ConnectionManager) fails to initialize.
     */
    private async initializeModules(): Promise<void> {
        const moduleConfig = this.config.modules;
        const initPromises: Promise<void>[] = [];

        this.logger.info('Initializing modules', {
            operation: 'initialize-modules',
            moduleConfig
        });

        // =============================================================================
        // PHASE 1: CORE INFRASTRUCTURE MODULES
        // =============================================================================

        // Initialize ConnectionManager first - required by all other modules
        if (moduleConfig.enableConnectionFactory) {
            this.logger.debug('Connection factory module enabled', {
                operation: 'module-config',
                module: 'connection-factory'
            });
            
            try {
                const { ConnectionManager } = await import('./modules/connection/ConnectionManager.js');
                const connectionManager = new ConnectionManager();
                
                await connectionManager.initialize(this);
                this.registerModule(connectionManager);
                
                this.logger.info('ConnectionManager initialized successfully', {
                    operation: 'module-init',
                    module: 'connection-manager'
                });
            } catch (error) {
                this.logger.error('Failed to initialize ConnectionManager', {
                    operation: 'module-init-error',
                    module: 'connection-manager',
                    error: error instanceof Error ? error.message : String(error)
                });
                throw error; // ConnectionManager is critical
            }
        }

        // Initialize ReconnectionManager after ConnectionManager if auto-reconnection is enabled
        if (moduleConfig.enableAutoReconnection) {
            this.logger.debug('Auto-reconnection module enabled', {
                operation: 'module-config',
                module: 'auto-reconnection'
            });
            
            try {
                const { ReconnectionManager } = await import('./modules/connection/ReconnectionManager.js');
                const reconnectionManager = new ReconnectionManager();
                
                await reconnectionManager.initialize(this);
                this.registerModule(reconnectionManager);
                
                this.logger.info('ReconnectionManager initialized successfully', {
                    operation: 'module-init',
                    module: 'reconnection-manager'
                });
            } catch (error) {
                this.logger.error('Failed to initialize ReconnectionManager', {
                    operation: 'module-init-error',
                    module: 'reconnection-manager',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // =============================================================================
        // PHASE 2: CACHING MODULES
        // =============================================================================

        // Initialize CacheManager - required by schema analysis and performance modules
        if (moduleConfig.enableAdvancedCaching) {
            this.logger.debug('Advanced caching module enabled', {
                operation: 'module-config',
                module: 'cache-manager'
            });
            
            try {
                const { CacheManager } = await import('./modules/cache/CacheManager.js');
                const cacheManager = new CacheManager();
                
                await cacheManager.initialize(this);
                this.registerModule(cacheManager);
                
                this.logger.info('CacheManager initialized successfully', {
                    operation: 'module-init',
                    module: 'cache-manager'
                });
            } catch (error) {
                this.logger.error('Failed to initialize CacheManager', {
                    operation: 'module-init-error',
                    module: 'cache-manager',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // Initialize CacheOptimizer after CacheManager
        if (moduleConfig.enableAdvancedCaching) {
            this.logger.debug('Cache optimizer module enabled', {
                operation: 'module-config',
                module: 'cache-optimizer'
            });
            
            try {
                const { CacheOptimizer } = await import('./modules/cache/CacheOptimizer.js');
                const cacheOptimizer = new CacheOptimizer();
                
                await cacheOptimizer.initialize(this);
                
                // Set CacheManager reference if available
                const cacheManager = this.getModule('cache-manager');
                if (cacheManager) {
                    (cacheOptimizer as any).setCacheManager(cacheManager);
                }
                
                this.registerModule(cacheOptimizer);
                
                this.logger.info('CacheOptimizer initialized successfully', {
                    operation: 'module-init',
                    module: 'cache-optimizer'
                });
            } catch (error) {
                this.logger.error('Failed to initialize CacheOptimizer', {
                    operation: 'module-init-error',
                    module: 'cache-optimizer',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // =============================================================================
        // PHASE 3: PERFORMANCE AND METRICS MODULES
        // =============================================================================

        // Initialize MetricsCollector - required by performance monitoring
        if (moduleConfig.enableMetricsCollection) {
            this.logger.debug('Metrics collection module enabled', {
                operation: 'module-config',
                module: 'metrics-collector'
            });
            
            try {
                const { MetricsCollector } = await import('./modules/performance/MetricsCollector.js');
                const metricsCollector = new MetricsCollector();
                
                await metricsCollector.initialize(this);
                this.registerModule(metricsCollector);
                
                this.logger.info('MetricsCollector initialized successfully', {
                    operation: 'module-init',
                    module: 'metrics-collector'
                });
            } catch (error) {
                this.logger.error('Failed to initialize MetricsCollector', {
                    operation: 'module-init-error',
                    module: 'metrics-collector',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // Initialize PerformanceMonitor after MetricsCollector
        if (moduleConfig.enableMetricsCollection) {
            this.logger.debug('Performance monitor module enabled', {
                operation: 'module-config',
                module: 'performance-monitor'
            });
            
            try {
                const { PerformanceMonitor } = await import('./modules/performance/PerformanceMonitor.js');
                const performanceMonitor = new PerformanceMonitor();
                
                await performanceMonitor.initialize(this);
                this.registerModule(performanceMonitor);
                
                this.logger.info('PerformanceMonitor initialized successfully', {
                    operation: 'module-init',
                    module: 'performance-monitor'
                });
            } catch (error) {
                this.logger.error('Failed to initialize PerformanceMonitor', {
                    operation: 'module-init-error',
                    module: 'performance-monitor',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // Initialize CacheStatsCollector after CacheManager and MetricsCollector
        if (moduleConfig.enableAdvancedCaching && moduleConfig.enableMetricsCollection) {
            this.logger.debug('Cache stats collector module enabled', {
                operation: 'module-config',
                module: 'cache-stats-collector'
            });
            
            try {
                const { CacheStatsCollector } = await import('./modules/cache/CacheStatsCollector.js');
                const cacheStatsCollector = new CacheStatsCollector();
                
                await cacheStatsCollector.initialize(this);
                
                // Set required module references
                const cacheManager = this.getModule('cache-manager');
                const metricsCollector = this.getModule('metrics-collector');
                
                if (cacheManager) {
                    (cacheStatsCollector as any).setCacheManager(cacheManager);
                }
                if (metricsCollector) {
                    (cacheStatsCollector as any).setMetricsCollector(metricsCollector);
                }
                
                this.registerModule(cacheStatsCollector);
                
                this.logger.info('CacheStatsCollector initialized successfully', {
                    operation: 'module-init',
                    module: 'cache-stats-collector'
                });
            } catch (error) {
                this.logger.error('Failed to initialize CacheStatsCollector', {
                    operation: 'module-init-error',
                    module: 'cache-stats-collector',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // =============================================================================
        // PHASE 4: TRANSACTION MANAGEMENT MODULES
        // =============================================================================

        // Initialize TransactionManager after ConnectionManager and before query modules
        if (moduleConfig.enableParameterizedQueries) {
            this.logger.debug('Transaction management module enabled', {
                operation: 'module-config',
                module: 'transaction-manager'
            });
            
            try {
                const { TransactionManager } = await import('./modules/transactions/TransactionManager.js');
                const transactionManager = new TransactionManager();
                
                await transactionManager.initialize(this);
                this.registerModule(transactionManager);
                
                this.logger.info('TransactionManager initialized successfully', {
                    operation: 'module-init',
                    module: 'transaction-manager'
                });
            } catch (error) {
                this.logger.error('Failed to initialize TransactionManager', {
                    operation: 'module-init-error',
                    module: 'transaction-manager',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // =============================================================================
        // PHASE 5: QUERY PROCESSING MODULES
        // =============================================================================

        // Initialize QueryValidator
        if (moduleConfig.enableQueryValidation) {
            this.logger.debug('Query validation module enabled', {
                operation: 'module-config',
                module: 'query-validation'
            });
            
            try {
                const { QueryValidator } = await import('./modules/query/QueryValidator.js');
                const queryValidator = new QueryValidator();
                
                await queryValidator.initialize(this);
                this.registerModule(queryValidator);
                
                this.logger.info('QueryValidator initialized successfully', {
                    operation: 'module-init',
                    module: 'query-validator'
                });
            } catch (error) {
                this.logger.error('Failed to initialize QueryValidator', {
                    operation: 'module-init-error',
                    module: 'query-validator',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }
        
        // Initialize ParameterizedQuery after QueryValidator
        if (moduleConfig.enableParameterizedQueries) {
            this.logger.debug('Parameterized queries module enabled', {
                operation: 'module-config',
                module: 'parameterized-queries'
            });
            
            try {
                const { ParameterizedQuery } = await import('./modules/query/ParameterizedQuery.js');
                const parameterizedQuery = new ParameterizedQuery();
                
                await parameterizedQuery.initialize(this);
                this.registerModule(parameterizedQuery);
                
                this.logger.info('ParameterizedQuery initialized successfully', {
                    operation: 'module-init',
                    module: 'parameterized-query'
                });
            } catch (error) {
                this.logger.error('Failed to initialize ParameterizedQuery', {
                    operation: 'module-init-error',
                    module: 'parameterized-query',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // =============================================================================
        // PHASE 6: SCHEMA ANALYSIS MODULES
        // =============================================================================

        // Initialize SchemaAnalyzer - required by RelationshipAnalyzer
        if (moduleConfig.enableRelationshipAnalysis) {
            this.logger.debug('Schema analyzer module enabled', {
                operation: 'module-config',
                module: 'schema-analyzer'
            });
            
            try {
                const { SchemaAnalyzer } = await import('./modules/schema/SchemaAnalyzer.js');
                const schemaAnalyzer = new SchemaAnalyzer();
                
                await schemaAnalyzer.initialize(this);
                this.registerModule(schemaAnalyzer);
                
                this.logger.info('SchemaAnalyzer initialized successfully', {
                    operation: 'module-init',
                    module: 'schema-analyzer'
                });
            } catch (error) {
                this.logger.error('Failed to initialize SchemaAnalyzer', {
                    operation: 'module-init-error',
                    module: 'schema-analyzer',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // Initialize RelationshipAnalyzer after SchemaAnalyzer
        if (moduleConfig.enableRelationshipAnalysis) {
            this.logger.debug('Relationship analysis module enabled', {
                operation: 'module-config',
                module: 'relationship-analyzer'
            });
            
            try {
                const { RelationshipAnalyzer } = await import('./modules/schema/RelationshipAnalyzer.js');
                const relationshipAnalyzer = new RelationshipAnalyzer();
                
                await relationshipAnalyzer.initialize(this);
                this.registerModule(relationshipAnalyzer);
                
                this.logger.info('RelationshipAnalyzer initialized successfully', {
                    operation: 'module-init',
                    module: 'relationship-analyzer'
                });
            } catch (error) {
                this.logger.error('Failed to initialize RelationshipAnalyzer', {
                    operation: 'module-init-error',
                    module: 'relationship-analyzer',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // Initialize DatabaseReporter after SchemaAnalyzer and RelationshipAnalyzer
        if (moduleConfig.enableRelationshipAnalysis) {
            this.logger.debug('Database reporter module enabled', {
                operation: 'module-config',
                module: 'database-reporter'
            });
            
            try {
                const { DatabaseReporter } = await import('./modules/schema/DatabaseReporter.js');
                const databaseReporter = new DatabaseReporter();
                
                await databaseReporter.initialize(this);
                this.registerModule(databaseReporter);
                
                this.logger.info('DatabaseReporter initialized successfully', {
                    operation: 'module-init',
                    module: 'database-reporter'
                });
            } catch (error) {
                this.logger.error('Failed to initialize DatabaseReporter', {
                    operation: 'module-init-error',
                    module: 'database-reporter',
                    error: error instanceof Error ? error.message : String(error)
                });
            }
        }

        // =============================================================================
        // FINALIZATION
        // =============================================================================

        await Promise.all(initPromises);
        this.logger.info('Module initialization complete', {
            operation: 'initialize-modules-complete',
            modulesLoaded: this.modules.size,
            moduleList: Array.from(this.modules.keys())
        });
    }

    /**
     * Gets the current status of the manager.
     * @returns {ManagerStatus} An object containing the current status information.
     */
    public getStatus(): ManagerStatus {
        return {
            state: this.state,
            isReady: this.state === ManagerState.READY || this.state === ManagerState.CONNECTED,
            isConnected: this.state === ManagerState.CONNECTED,
            lastError: this.lastError,
            connectionCount: this.connectionCount,
            uptime: Date.now() - this.startTime,
            modulesLoaded: Array.from(this.modules.keys())
        };
    }

    /**
     * Gets the read-only configuration of the manager.
     * @returns {Readonly<Required<HSQLManagerConfiguration>>} The manager's configuration.
     */
    public getConfiguration(): Readonly<Required<HSQLManagerConfiguration>> {
        return Object.freeze({ ...this.config });
    }

    /**
     * Generates the HSQLDB connection URL for the configured world.
     * @returns {string} The database connection URL.
     */
    public getDatabaseUrl(): string {
        const url = generateDatabaseUrl(
            this.config.starmadeDir,
            this.config.worldName,
            {
                readOnly: this.config.connection.readOnly,
                ifExists: true,
                shutdown: true,
                // CRITICAL FIX: Include database-specific options from config
                disableLockFile: this.config.database.disableLockFile
            }
        );
        
        this.logger.debug('Database URL generated', {
            operation: 'generate-url',
            url,
            readOnly: this.config.connection.readOnly,
            worldName: this.config.worldName,
            disableLockFile: this.config.database.disableLockFile
        });
        
        return url;
    }

    /**
     * Gets a registered module by its name.
     * @template T - The type of the module to retrieve.
     * @param {string} name - The name of the module.
     * @returns {T | undefined} The module instance, or undefined if not found.
     */
    public getModule<T extends BaseModule>(name: string): T | undefined {
        return this.modules.get(name) as T | undefined;
    }

    /**
     * Registers a new module with the manager.
     * @param {BaseModule} module - The module instance to register.
     * @throws {ModuleAlreadyRegisteredError} If a module with the same name is already registered.
     */
    public registerModule(module: BaseModule): void {
        if (this.modules.has(module.name)) {
            throw new ModuleAlreadyRegisteredError(module.name, {
                operation: 'register-module',
                existingModules: Array.from(this.modules.keys())
            });
        }
        
        this.modules.set(module.name, module);
        this.logger.info('Module registered', {
            operation: 'register-module',
            moduleName: module.name,
            moduleVersion: module.version,
            totalModules: this.modules.size
        });
    }

    /**
     * Unregisters a module from the manager and calls its destroy method.
     * @async
     * @param {string} name - The name of the module to unregister.
     * @returns {Promise<void>} A promise that resolves when the module is unregistered.
     * @throws {Error} If the module's destroy method fails.
     */
    public async unregisterModule(name: string): Promise<void> {
        const module = this.modules.get(name);
        if (module) {
            this.logger.info('Unregistering module', {
                operation: 'unregister-module',
                moduleName: name
            });
            
            try {
                await module.destroy();
                this.modules.delete(name);
                
                this.logger.info('Module unregistered successfully', {
                    operation: 'unregister-module-complete',
                    moduleName: name,
                    remainingModules: this.modules.size
                });
            } catch (error) {
                this.logger.error('Failed to unregister module', {
                    operation: 'unregister-module-error',
                    moduleName: name,
                    error: error instanceof Error ? error.message : String(error)
                });
                throw error;
            }
        } else {
            this.logger.warn('Attempted to unregister non-existent module', {
                operation: 'unregister-module',
                moduleName: name
            });
        }
    }

    /**
     * Internal logging method that falls back to the console if the primary logger is not available.
     * @private
     * @param {'debug' | 'info' | 'warn' | 'error'} level - The log level.
     * @param {string} message - The log message.
     * @param {Record<string, any>} [context] - Additional context for the log entry.
     */
    private log(level: 'debug' | 'info' | 'warn' | 'error', message: string, context?: Record<string, any>): void {
        if (this.loggerInitialized && this.logger) {
            this.logger[level](message, context);
        } else {
            // Fallback to console logging
            const logConfig = this.config.logging;
            const levels: Record<string, number> = { debug: 0, info: 1, warn: 2, error: 3 };
            const currentLogLevel = logConfig.logLevel || 'info';
            
            if (levels[level] < levels[currentLogLevel]) {
                return;
            }

            const timestamp = new Date().toISOString();
            const logMessage = `[${timestamp}] [HSQLManager] [${level.toUpperCase()}] ${message}`;


            if (context) {
                console[level](logMessage, context);
            } else {
                console[level](logMessage);
            }
        }
    }

    /**
     * Destroys the manager and all its registered modules, cleaning up all resources.
     * Modules are destroyed in the reverse order of their initialization (LIFO).
     * @async
     * @returns {Promise<void>} A promise that resolves when destruction is complete.
     * @throws {HSQLDBError} If the destruction process fails.
     */
    public async destroy(): Promise<void> {
        if (this.destroyed) {
            return;
        }

        this.state = ManagerState.DISCONNECTING;
        this.logger.info('Starting HSQLManager destruction', {
            operation: 'destroy',
            modulesToDestroy: this.modules.size
        });

        try {
            // =============================================================================
            // LIFO DESTRUCTION - REVERSE ORDER OF INITIALIZATION
            // =============================================================================
            
            // Get modules in reverse order of initialization (LIFO - Last In, First Out)
            const moduleEntries = Array.from(this.modules.entries());
            const destroyOrder = [
                // Phase 6: Schema analysis modules (destroy first - last initialized)
                'database-reporter',
                'relationship-analyzer', 
                'schema-analyzer',
                
                // Phase 5: Query processing modules
                'parameterized-query',
                'query-validator',
                
                // Phase 4: Transaction management modules
                'transaction-manager',
                
                // Phase 3: Performance and metrics modules
                'cache-stats-collector',
                'performance-monitor',
                'metrics-collector',
                
                // Phase 2: Caching modules
                'cache-optimizer',
                'cache-manager',
                
                // Phase 1: Core infrastructure modules (destroy last - first initialized)
                'reconnection-manager',
                'connection-manager'
            ];
            // Destroy modules in LIFO order
            for (const moduleName of destroyOrder) {
                const module = this.modules.get(moduleName);
                if (module) {
                    this.logger.info('Destroying module', {
                        operation: 'destroy-module',
                        moduleName: moduleName,
                        moduleVersion: module.version
                    });
                    
                    try {
                        await module.destroy();
                        this.modules.delete(moduleName);
                        
                        this.logger.info('Module destroyed successfully', {
                            operation: 'destroy-module-complete',
                            moduleName: moduleName,
                            remainingModules: this.modules.size
                        });
                    } catch (error) {
                        this.logger.error('Failed to destroy module', {
                            operation: 'destroy-module-error',
                            moduleName: moduleName,
                            error: error instanceof Error ? error.message : String(error)
                        });
                        // Continue with other modules even if one fails
                    }
                }
            }

            // Destroy any remaining modules (in case of manual registration)
            const remainingModules = Array.from(this.modules.values());
            if (remainingModules.length > 0) {
                this.logger.warn('Destroying remaining unordered modules', {
                    operation: 'destroy-remaining-modules',
                    remainingCount: remainingModules.length,
                    moduleNames: remainingModules.map(m => m.name)
                });
                
                const destroyPromises = remainingModules.map(module => 
                    module.destroy().catch(error => {
                        this.logger.warn('Failed to destroy remaining module', {
                            operation: 'destroy-remaining-module-error',
                            moduleName: module.name,
                            error: error instanceof Error ? error.message : String(error)
                        });
                    })
                );
                
                await Promise.allSettled(destroyPromises);
            }

            // Clear all modules
            this.modules.clear();

            this.state = ManagerState.DESTROYED;
            this.destroyed = true;
            
            // Unregister from resource cleaner
            resourceCleaner.unregister(this);
            
            this.logger.info('HSQLManager destroyed successfully', {
                operation: 'destroy-complete',
                uptime: Date.now() - this.startTime,
                destroyedModules: destroyOrder.length
            });

        } catch (error) {
            this.state = ManagerState.ERROR;
            this.lastError = new HSQLDBError(
                `Failed to destroy manager: ${error instanceof Error ? error.message : String(error)}`,
                'DESTROY_ERROR'
            );
            
            this.logger.error('HSQLManager destruction failed', {
                operation: 'destroy-error',
                error: this.lastError.message,
                errorCode: this.lastError.code
            });
            
            throw this.lastError;
        }
    }

    /**
     * A static factory method to create and initialize an HSQLManager instance.
     * @static
     * @async
     * @param {HSQLManagerConfiguration} config - The configuration for the manager.
     * @returns {Promise<HSQLManager>} A promise that resolves with the fully initialized manager.
     */
    public static async create(config: HSQLManagerConfiguration): Promise<HSQLManager> {
        const manager = new HSQLManager(config);
        await manager.initialize();
        return manager;
    }

    /**
     * Performs a health check on the manager and its modules.
     * @async
     * @returns {Promise<{healthy: boolean; status: ManagerStatus; issues: string[]}>} A promise that resolves with the health check result.
     */
    public async healthCheck(): Promise<{
        healthy: boolean;
        status: ManagerStatus;
        issues: string[];
    }> {
        const status = this.getStatus();
        const issues: string[] = [];

        this.logger.debug('Performing health check', {
            operation: 'health-check',
            currentState: status.state
        });

        // Check if manager is in a good state
        if (!status.isReady) {
            issues.push(`Manager not ready (state: ${status.state})`);
        }

        if (status.lastError) {
            issues.push(`Last error: ${status.lastError.message}`);
        }

        // TODO: Add module-specific health checks as modules are implemented

        const healthResult = {
            healthy: issues.length === 0,
            status,
            issues
        };

        this.logger.info('Health check completed', {
            operation: 'health-check-complete',
            healthy: healthResult.healthy,
            issueCount: issues.length,
            issues
        });

        return healthResult;
    }
}

