/**
 * Transaction Context Module
 * 
 * Provides transaction-scoped execution context with support for savepoints,
 * nested transactions, and transaction-aware operations.
 * 
 * **Responsibilities:**
 * - Transaction-scoped query execution
 * - Savepoint creation and management
 * - Transaction state tracking
 * - Resource management within transaction scope
 * - Nested transaction support
 * - Transaction rollback to specific savepoints
 * 
 * **Integration:**
 * - Used by TransactionManager for transaction execution
 * - Provides database connection access within transaction scope
 * - Integrates with QueryExecutor for transaction-aware queries
 * - Supports transaction event emission
 * 
 * @author InitSysRev
 * @version 1.0.0
 * 
 * @example
 * ```typescript
 * // Used within TransactionManager.executeTransaction()
 * const result = await transactionManager.executeTransaction(async (ctx) => {
 *     // Execute queries within transaction
 *     await ctx.execute('INSERT INTO players (name) VALUES (?)', ['PlayerName']);
 *     
 *     // Create savepoint for partial rollback
 *     const savepoint = await ctx.createSavepoint('before_update');
 *     
 *     try {
 *         await ctx.execute('UPDATE stats SET score = ? WHERE player = ?', [1000, 'PlayerName']);
 *     } catch (error) {
 *         // Rollback to savepoint instead of entire transaction
 *         await ctx.rollbackToSavepoint(savepoint);
 *         await ctx.execute('UPDATE stats SET score = ? WHERE player = ?', [500, 'PlayerName']);
 *     }
 *     
 *     // Query within transaction
 *     const result = await ctx.query('SELECT * FROM players WHERE name = ?', ['PlayerName']);
 *     
 *     return { player: result[0], success: true };
 * });
 * ```
 */

import { HSQLDBError, ModuleError, ErrorFactory } from '../../errors.js';
import { createModuleLogger, type ModuleLogger } from '../logging/Logger.js';
import { createEventData } from '../../events.js';
import type { TransactionManager, TransactionOptions, IsolationLevel, TransactionEvent } from './TransactionManager.js';

// =============================================================================
// TRANSACTION CONTEXT INTERFACES
// =============================================================================

/**
 * Savepoint information
 */
export interface SavepointInfo {
    /** Savepoint name */
    name: string;
    /** Creation timestamp */
    createdAt: Date;
    /** Savepoint order (for nested savepoints) */
    order: number;
    /** Whether savepoint is still valid */
    isValid: boolean;
}

/**
 * Query execution result within transaction context
 */
export interface TransactionQueryResult {
    /** Number of rows affected (for INSERT/UPDATE/DELETE) */
    affectedRows?: number;
    /** Result rows (for SELECT) */
    rows?: any[];
    /** Query execution time in milliseconds */
    executionTime: number;
    /** Whether query was successful */
    success: boolean;
    /** Query metadata */
    metadata?: {
        columnCount: number;
        columnNames: string[];
        columnTypes: string[];
    };
}

/**
 * Batch execution parameters
 */
export interface BatchParameters {
    /** SQL statement to execute */
    sql: string;
    /** Array of parameter arrays for batch execution */
    parameterSets: any[][];
}

/**
 * Batch execution result
 */
export interface BatchExecutionResult {
    /** Array of results for each parameter set */
    results: TransactionQueryResult[];
    /** Total execution time in milliseconds */
    totalExecutionTime: number;
    /** Number of successful executions */
    successCount: number;
    /** Number of failed executions */
    failureCount: number;
    /** Errors encountered during batch execution */
    errors: Error[];
}

/**
 * Transaction context state
 */
export interface TransactionContextState {
    /** Transaction ID */
    transactionId: string;
    /** Current isolation level */
    isolationLevel: IsolationLevel;
    /** Whether transaction is read-only */
    readOnly: boolean;
    /** Transaction start time */
    startTime: Date;
    /** Active savepoints */
    savepoints: SavepointInfo[];
    /** Number of queries executed */
    queryCount: number;
    /** Total execution time for all queries */
    totalQueryTime: number;
    /** Whether context is still valid */
    isValid: boolean;
}

// =============================================================================
// MAIN TRANSACTION CONTEXT CLASS
// =============================================================================

/**
 * TransactionContext Class
 * 
 * Provides execution context for database operations within a transaction.
 * Manages savepoints, query execution, and transaction state.
 */
export class TransactionContext {
    private readonly transactionId: string;
    private readonly connection: any; // JDBC Connection from JDBCConnectionFactory
    private readonly transactionManager: TransactionManager;
    private readonly options: TransactionOptions;
    private readonly logger: ModuleLogger;
    private readonly startTime: Date;
    
    private savepoints: Map<string, SavepointInfo> = new Map();
    private savepointCounter = 0;
    private queryCount = 0;
    private totalQueryTime = 0;
    private valid = true;

    constructor(
        transactionId: string,
        connection: any,
        transactionManager: TransactionManager,
        options: TransactionOptions
    ) {
        this.transactionId = transactionId;
        this.connection = connection;
        this.transactionManager = transactionManager;
        this.options = options;
        this.logger = createModuleLogger(`TransactionContext:${transactionId}`);
        this.startTime = new Date();

        this.logger.debug('TransactionContext created', {
            operation: 'create-context',
            transactionId,
            options
        });
    }

    /**
     * Get the transaction ID
     */
    public getTransactionId(): string {
        return this.transactionId;
    }

    /**
     * Get the underlying database connection
     */
    public getConnection(): any {
        this.ensureValid();
        return this.connection;
    }

    /**
     * Get transaction context state
     */
    public getState(): TransactionContextState {
        return {
            transactionId: this.transactionId,
            isolationLevel: this.options.isolationLevel || 'READ_COMMITTED' as IsolationLevel,
            readOnly: this.options.readOnly || false,
            startTime: this.startTime,
            savepoints: Array.from(this.savepoints.values()),
            queryCount: this.queryCount,
            totalQueryTime: this.totalQueryTime,
            isValid: this.valid
        };
    }

    /**
     * Execute a SQL statement within the transaction
     * CRITICAL FIX: Properly handle JDBCConnection interface and convert to expected format
     */
    public async execute(sql: string, parameters: any[] = []): Promise<TransactionQueryResult> {
        this.ensureValid();
        
        const startTime = Date.now();
        this.logger.debug('Executing SQL within transaction', {
            operation: 'execute-sql',
            transactionId: this.transactionId,
            sql: this.options.enableLogging ? sql : '[SQL HIDDEN]',
            parameterCount: parameters.length
        });

        try {
            // CRITICAL FIX: Use the JDBCConnection interface properly
            // The connection object has an execute method that returns JDBCQueryResult
            const jdbcResult = await this.connection.execute(sql, parameters);
            
            const executionTime = Date.now() - startTime;
            
            // Update statistics
            this.queryCount++;
            this.totalQueryTime += executionTime;

            this.logger.debug('SQL execution completed', {
                operation: 'execute-sql-success',
                transactionId: this.transactionId,
                executionTime: executionTime,
                affectedRows: jdbcResult.rowsAffected,
                rowCount: jdbcResult.rows?.length
            });

            // CRITICAL FIX: Convert JDBCQueryResult to TransactionQueryResult format
            const transactionResult: TransactionQueryResult = {
                success: true,
                executionTime: executionTime, // Use our calculated time
                affectedRows: jdbcResult.rowsAffected,
                rows: jdbcResult.rows || [],
                metadata: jdbcResult.columns ? {
                    columnCount: jdbcResult.columns.length,
                    columnNames: jdbcResult.columns.map((col: any) => col.name),
                    columnTypes: jdbcResult.columns.map((col: any) => col.type)
                } : undefined
            };

            return transactionResult;
            
        } catch (error) {
            const executionTime = Date.now() - startTime;
            this.logger.error('SQL execution failed', {
                operation: 'execute-sql-error',
                transactionId: this.transactionId,
                sql: this.options.enableLogging ? sql : '[SQL HIDDEN]',
                executionTime,
                error: error instanceof Error ? error.message : String(error)
            });
            
            throw new HSQLDBError(
                `SQL execution failed: ${error instanceof Error ? error.message : String(error)}`,
                'SQL_EXECUTION_FAILED'
            );
        }
    }

    /**
     * Execute a SELECT query and return results directly
     * CRITICAL FIX: Return rows in the format expected by tests
     */
    public async query(sql: string, parameters: any[] = []): Promise<any[]> {
        const result = await this.execute(sql, parameters);
        
        // CRITICAL FIX: Return rows directly from the result
        // The JDBCConnection already provides rows in array format
        return result.rows || [];
    }

    /**
     * Execute a batch of SQL statements with enhanced error reporting
     */
    public async executeBatch(batch: BatchParameters): Promise<BatchExecutionResult> {
        this.ensureValid();
        
        const startTime = Date.now();
        this.logger.info('Executing batch within transaction', {
            operation: 'execute-batch',
            transactionId: this.transactionId,
            sql: this.options.enableLogging ? batch.sql : '[SQL HIDDEN]',
            batchSize: batch.parameterSets.length
        });

        const results: TransactionQueryResult[] = [];
        const errors: Error[] = [];
        let successCount = 0;

        try {
            // AMÉLIORATION: Processing par chunks pour de meilleures performances sur de gros batches
            const chunkSize = 50; // Traiter par chunks de 50 pour éviter les timeouts
            
            for (let chunkStart = 0; chunkStart < batch.parameterSets.length; chunkStart += chunkSize) {
                const chunkEnd = Math.min(chunkStart + chunkSize, batch.parameterSets.length);
                const chunk = batch.parameterSets.slice(chunkStart, chunkEnd);
                
                this.logger.debug('Processing batch chunk', {
                    operation: 'execute-batch-chunk',
                    transactionId: this.transactionId,
                    chunkStart,
                    chunkEnd,
                    chunkSize: chunk.length
                });
                
                for (let i = 0; i < chunk.length; i++) {
                    const globalIndex = chunkStart + i;
                    try {
                        const result = await this.execute(batch.sql, chunk[i]);
                        results.push(result);
                        successCount++;
                    } catch (error) {
                        const failedResult: TransactionQueryResult = {
                            executionTime: 0,
                            success: false
                        };
                        results.push(failedResult);
                        const enhancedError = new Error(
                            `Batch operation ${globalIndex + 1}/${batch.parameterSets.length} failed: ${error instanceof Error ? error.message : String(error)}`
                        );
                        errors.push(enhancedError);
                        
                        this.logger.warn('Batch item failed', {
                            operation: 'execute-batch-item-error',
                            transactionId: this.transactionId,
                            itemIndex: globalIndex,
                            error: error instanceof Error ? error.message : String(error)
                        });
                    }
                }
            }

            const totalExecutionTime = Date.now() - startTime;

            this.logger.info('Batch execution completed', {
                operation: 'execute-batch-complete',
                transactionId: this.transactionId,
                batchSize: batch.parameterSets.length,
                successCount,
                failureCount: batch.parameterSets.length - successCount,
                totalExecutionTime
            });

            return {
                results,
                totalExecutionTime,
                successCount,
                failureCount: batch.parameterSets.length - successCount,
                errors
            };

        } catch (error) {
            this.logger.error('Batch execution failed', {
                operation: 'execute-batch-error',
                transactionId: this.transactionId,
                error: error instanceof Error ? error.message : String(error)
            });
            throw error;
        }
    }

    /**
     * Create a savepoint within the transaction
     * CRITICAL FIX: Always increment counter before using, regardless of whether name is provided
     */
    public async createSavepoint(name?: string): Promise<string> {
        this.ensureValid();
        
        // CRITICAL FIX: Always increment the counter before using it
        this.savepointCounter++;
        const savepointName = name || `sp_${this.savepointCounter}`;
        
        this.logger.debug('Creating savepoint', {
            operation: 'create-savepoint',
            transactionId: this.transactionId,
            savepointName,
            order: this.savepointCounter
        });

        try {
            // CRITICAL FIX: Create database savepoint using SQL
            // HSQLDB supports savepoints via SQL: SAVEPOINT <name>
            await this.connection.execute(`SAVEPOINT ${savepointName}`, []);

            // CRITICAL FIX: Use the incremented savepointCounter as order
            const savepointInfo: SavepointInfo = {
                name: savepointName,
                createdAt: new Date(),
                order: this.savepointCounter, // Use the incremented value
                isValid: true
            };

            this.savepoints.set(savepointName, savepointInfo);

            // Emit savepoint creation event via TransactionManager
            this.transactionManager.emit('savepoint:created', createEventData('savepoint:created', {
                transactionId: this.transactionId,
                savepointName,
                order: this.savepointCounter,
                timestamp: new Date()
            }, 'TransactionContext'));

            this.logger.debug('Savepoint created successfully', {
                operation: 'create-savepoint-success',
                transactionId: this.transactionId,
                savepointName,
                order: this.savepointCounter
            });

            return savepointName;

        } catch (error) {
            // NOUVEAU: En cas d'erreur, décrémenter le compteur pour maintenir la cohérence
            this.savepointCounter--;
            
            this.logger.error('Savepoint creation failed', {
                operation: 'create-savepoint-error',
                transactionId: this.transactionId,
                savepointName,
                error: error instanceof Error ? error.message : String(error)
            });

            throw new ModuleError(
                'TransactionContext',
                'createSavepoint',
                `Failed to create savepoint '${savepointName}': ${error instanceof Error ? error.message : String(error)}`
            );
        }
    }

    /**
     * Rollback to a specific savepoint
     */
    public async rollbackToSavepoint(savepointName: string): Promise<void> {
        this.ensureValid();
        
        const savepointInfo = this.savepoints.get(savepointName);
        if (!savepointInfo || !savepointInfo.isValid) {
            throw new ModuleError(
                'TransactionContext',
                'rollbackToSavepoint',
                `Savepoint '${savepointName}' not found`
            );
        }

        this.logger.debug('Rolling back to savepoint', {
            operation: 'rollback-to-savepoint',
            transactionId: this.transactionId,
            savepointName
        });

        try {
            // CRITICAL FIX: Rollback to savepoint using SQL
            // HSQLDB supports savepoint rollback via SQL: ROLLBACK TO SAVEPOINT <name>
            await this.connection.execute(`ROLLBACK TO SAVEPOINT ${savepointName}`, []);

            // Invalidate all savepoints created after this one
            for (const [name, info] of this.savepoints.entries()) {
                if (info.order > savepointInfo.order) {
                    info.isValid = false;
                }
            }

            // Emit savepoint rollback event via TransactionManager
            this.transactionManager.emit('savepoint:rolled-back', createEventData('savepoint:rolled-back', {
                transactionId: this.transactionId,
                savepointName,
                timestamp: new Date()
            }, 'TransactionContext'));

            this.logger.debug('Rollback to savepoint completed', {
                operation: 'rollback-to-savepoint-success',
                transactionId: this.transactionId,
                savepointName
            });

        } catch (error) {
            this.logger.error('Rollback to savepoint failed', {
                operation: 'rollback-to-savepoint-error',
                transactionId: this.transactionId,
                savepointName,
                error: error instanceof Error ? error.message : String(error)
            });

            throw new HSQLDBError(
                `Rollback to savepoint failed: ${error instanceof Error ? error.message : String(error)}`,
                'SAVEPOINT_ROLLBACK_FAILED'
            );
        }
    }

    /**
     * Release a savepoint (no longer needed)
     */
    public async releaseSavepoint(savepointName: string): Promise<void> {
        this.ensureValid();
        
        const savepointInfo = this.savepoints.get(savepointName);
        if (!savepointInfo || !savepointInfo.isValid) {
            throw new ModuleError(
                'TransactionContext',
                'releaseSavepoint',
                'Savepoint not found or invalid'
            );
        }

        this.logger.debug('Releasing savepoint', {
            operation: 'release-savepoint',
            transactionId: this.transactionId,
            savepointName
        });

        try {
            // CRITICAL FIX: Release savepoint using SQL
            // HSQLDB supports savepoint release via SQL: RELEASE SAVEPOINT <name>
            await this.connection.execute(`RELEASE SAVEPOINT ${savepointName}`, []);

            // Mark as invalid
            savepointInfo.isValid = false;
            
            // Emit savepoint release event via TransactionManager
            this.transactionManager.emit('savepoint:released', createEventData('savepoint:released', {
                transactionId: this.transactionId,
                savepointName,
                timestamp: new Date()
            }, 'TransactionContext'));

            this.logger.debug('Savepoint released successfully', {
                operation: 'release-savepoint-success',
                transactionId: this.transactionId,
                savepointName
            });

        } catch (error) {
            this.logger.error('Savepoint release failed', {
                operation: 'release-savepoint-error',
                transactionId: this.transactionId,
                savepointName,
                error: error instanceof Error ? error.message : String(error)
            });

            throw new HSQLDBError(
                `Savepoint release failed: ${error instanceof Error ? error.message : String(error)}`,
                'SAVEPOINT_RELEASE_FAILED'
            );
        }
    }

    /**
     * Get list of active savepoints
     */
    public getActiveSavepoints(): SavepointInfo[] {
        return Array.from(this.savepoints.values()).filter(sp => sp.isValid);
    }

    /**
     * Commit the transaction
     */
    public async commit(): Promise<void> {
        this.ensureValid();
        
        this.logger.debug('Committing transaction via context', {
            operation: 'commit-via-context',
            transactionId: this.transactionId
        });

        try {
            await this.transactionManager.commitTransaction(this.transactionId);
            this.invalidate();
        } catch (error) {
            this.invalidate();
            throw error;
        }
    }

    /**
     * Rollback the transaction
     */
    public async rollback(reason?: string): Promise<void> {
        this.ensureValid();
        
        this.logger.debug('Rolling back transaction via context', {
            operation: 'rollback-via-context',
            transactionId: this.transactionId,
            reason
        });

        try {
            await this.transactionManager.rollbackTransaction(this.transactionId, reason);
            this.invalidate();
        } catch (error) {
            this.invalidate();
            throw error;
        }
    }

    // =============================================================================
    // TRANSACTION CONTEXT EVENT DELEGATION
    // =============================================================================

    /**
     * Add event listener (delegates to TransactionManager)
     */
    public on(event: TransactionEvent, listener: (event: TransactionEvent, data?: any) => void): void {
        this.transactionManager.on(event, listener);
    }

    /**
     * Add one-time event listener (delegates to TransactionManager)
     */
    public once(event: TransactionEvent, listener: (event: TransactionEvent, data?: any) => void): void {
        this.transactionManager.once(event, listener);
    }

    /**
     * Remove event listener (delegates to TransactionManager)
     */
    public off(event: TransactionEvent, listener: (event: TransactionEvent, data?: any) => void): void {
        this.transactionManager.off(event, listener);
    }

    /**
     * Emit event (delegates to TransactionManager)
     */
    public emit(event: TransactionEvent, data?: any): void {
        this.transactionManager.emit(event, data);
    }

    /**
     * Remove all listeners for an event (delegates to TransactionManager)
     */
    public removeAllListeners(event?: TransactionEvent): void {
        this.transactionManager.removeAllListeners(event);
    }

    /**
     * Get listener count for an event (delegates to TransactionManager)
     */
    public listenerCount(event: TransactionEvent): number {
        return this.transactionManager.listenerCount(event);
    }

    /**
     * Get all events that have listeners (delegates to TransactionManager)
     */
    public eventNames(): TransactionEvent[] {
        return this.transactionManager.eventNames();
    }

    /**
     * Listen to savepoint events only
     */
    public onSavepointEvent(
        event: 'savepoint:created' | 'savepoint:released' | 'savepoint:rolled-back',
        listener: (event: TransactionEvent, data: { transactionId: string; savepointName: string; timestamp: Date }) => void
    ): void {
        this.transactionManager.on(event, listener);
    }

    /**
     * Listen to transaction-specific events only (filtered by this transaction ID)
     */
    public onTransactionEvent(
        event: TransactionEvent,
        listener: (event: TransactionEvent, data: any) => void
    ): void {
        const filteredListener = (evt: TransactionEvent, data: any) => {
            // Only trigger for events related to this transaction
            if (data && data.transactionId === this.transactionId) {
                listener(evt, data);
            }
        };
        
        this.transactionManager.on(event, filteredListener);
    }

    /**
     * Get transaction-specific listener count
     */
    public getTransactionListenerCount(): number {
        // This would require tracking transaction-specific listeners
        // For now, return the total count from TransactionManager
        return this.transactionManager.eventNames().reduce(
            (total, event) => total + this.transactionManager.listenerCount(event),
            0
        );
    }

    // =============================================================================
    // PRIVATE HELPER METHODS
    // =============================================================================

    /**
     * Ensure the context is still valid
     */
    private ensureValid(): void {
        if (!this.valid) {
            throw new ModuleError(
                'TransactionContext',
                'ensureValid',
                'Transaction context destroyed'
            );
        }
    }

    /**
     * Invalidate the context
     */
    private invalidate(): void {
        this.valid = false;

        // Invalidate all savepoints
        for (const savepoint of this.savepoints.values()) {
            savepoint.isValid = false;
        }

        this.logger.debug('TransactionContext invalidated', {
            operation: 'invalidate-context',
            transactionId: this.transactionId
        });
    }
}