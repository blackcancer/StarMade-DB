/**
 * Validate test database exists
 */
function validateTestDatabase(): void {
    const dbPath = resolve(TRANSACTION_CONTEXT_TEST_CONFIG.starmadeDir, 'server-database', TRANSACTION_CONTEXT_TEST_CONFIG.worldName, 'index');
    
    if (!existsSync(TRANSACTION_CONTEXT_TEST_CONFIG.starmadeDir)) {
        throw new Error(`Test StarMade directory not found: ${TRANSACTION_CONTEXT_TEST_CONFIG.starmadeDir}`);
    }
    
    const requiredFiles = ['.data', '.properties', '.script'];
    for (const file of requiredFiles) {
        const filePath = resolve(dbPath, file);
        if (!existsSync(filePath)) {
            throw new Error(`Required database file not found: ${filePath}`);
        }
    }
}

/**
 * Suppress console output during tests
 */
function suppressConsoleOutput(): { restore: () => void } {
    const originalConsole = {
        log: console.log,
        warn: console.warn,
        error: console.error,
        info: console.info,
        debug: console.debug
    };
    
    // ACTIVATION DES LOGS: Ne plus supprimer la sortie console pour diagnostiquer les problèmes
    // console.log = () => {};
    // console.warn = () => {};
    // console.error = () => {};
    // console.info = () => {};
    // console.debug = () => {};
    
    return {
        restore: () => {
            Object.assign(console, originalConsole);
        }
    };
}

/**
 * Sleep utility for timing tests
 */
function sleep(ms: number): Promise<void> {
    return new Promise(resolve => setTimeout(resolve, ms));
}

/**
 * Create a test table for context testing
 */
async function createTestTable(context: TransactionContext, tableName: string = 'TEST_CONTEXT'): Promise<void> {
    await context.execute(`
        CREATE TABLE IF NOT EXISTS ${tableName} (
            id INTEGER PRIMARY KEY,
            value VARCHAR(100),
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    `);
}

/**
 * Drop test table
 */
async function dropTestTable(context: TransactionContext, tableName: string = 'TEST_CONTEXT'): Promise<void> {
    try {
        await context.execute(`DROP TABLE IF EXISTS ${tableName}`);
    } catch (error) {
        // Ignore errors during cleanup
    }
}

