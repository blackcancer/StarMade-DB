        if (transactionManager && transactionManager.isInitialized) {
            try {
                // Force cleanup of any remaining transactions
                const activeCount = transactionManager.getActiveTransactionCount();
                if (activeCount > 0) {
                    console.log(`Cleaning up ${activeCount} active transactions`);
                    if (typeof (transactionManager as any).rollbackAllTransactions === 'function') {
                        await (transactionManager as any).rollbackAllTransactions('Test cleanup afterEach');
                    }
