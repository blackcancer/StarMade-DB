            } catch (error) {
                // Ignore cleanup errors
            }
        }
        
        // CRITIQUE: Nettoyer la table de test entre les tests pour éviter les conflits d'ID
        try {
            if (transactionManager && transactionManager.isInitialized) {
                const cleanupContext = await transactionManager.beginTransaction();
                try {
                    // Drop the main test table
                    await dropTestTable(cleanupContext);

                    // Discover and drop dynamically created DDL test tables
                    const tables = await cleanupContext.query("SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'PUBLIC' AND TABLE_NAME LIKE 'TEST_DDL_%'");
                    for (const row of tables) {
                        // Handle both array and object row formats from the JDBC driver
                        const tableName = Array.isArray(row) ? row[0] : (row as any).TABLE_NAME;
                        if (tableName) {
                            await cleanupContext.execute(`DROP TABLE IF EXISTS ${tableName}`);
                        }
                    }
                    await cleanupContext.commit();
                } catch (cleanupError) {
                    await cleanupContext.rollback('Cleanup failed');
                }
            }
        } catch (cleanupError) {
            // Ignore cleanup errors but log them
            console.log('Test cleanup warning:', (cleanupError as Error).message);
