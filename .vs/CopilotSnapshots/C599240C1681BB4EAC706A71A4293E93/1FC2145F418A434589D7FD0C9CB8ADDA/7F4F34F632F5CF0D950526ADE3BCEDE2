                expect(error).to.be.instanceOf(ModuleError);
                expect((error as Error).message).to.include('ConnectionManager module required');
            } finally {
                await testHSQLManager.destroy();
            }
        });

        it('should handle null manager gracefully', async function() {
            const testManager = new TransactionManager();
            
            try {
                await testManager.initialize(null as any);
                expect.fail('Should have thrown an error');
            } catch (error: unknown) {
                expect(error).to.be.instanceOf(Error);
            }
        });

        it('should validate configuration ranges', function() {
            const invalidConfigs = [
