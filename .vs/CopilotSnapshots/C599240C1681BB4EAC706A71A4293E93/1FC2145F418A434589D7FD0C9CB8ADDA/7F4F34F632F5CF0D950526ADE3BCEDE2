                    await transaction.rollback('Manual test failed');
                    throw manualError;
                }
            }
        });

        it('should rollback transaction on executor error', async function() {
            // SIMPLIFICATION MAXIMALE: Test d'erreur très simple
            try {
                await transactionManager.executeTransaction(async (ctx) => {
                    // Pas d'opération sur table, juste une erreur simple
                    throw new Error('Intentional test error');
                });
                
                expect.fail('Should have thrown an error');
            } catch (error: unknown) {
                expect((error as Error).message).to.equal('Intentional test error');
            }
        });

        it('should handle transaction with custom options', async function() {
