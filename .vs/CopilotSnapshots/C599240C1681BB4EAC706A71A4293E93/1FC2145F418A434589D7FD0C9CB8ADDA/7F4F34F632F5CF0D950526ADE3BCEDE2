describe('TransactionManager Comprehensive Tests', function() {
    this.timeout(60000); // AUGMENTATION: 60 secondes au lieu de 30 pour les tests lents

    let manager: HSQLManager;
    let connectionManager: any;
    let transactionManager: TransactionManager;
    let consoleSuppressor: { restore: () => void };

    before(async function() {
        consoleSuppressor = suppressConsoleOutput();
        
        try {
            validateTestDatabase();
        } catch (error: unknown) {
            console.log('Skipping TransactionManager tests: Test database not available');
            console.log('Error:', (error as Error).message);
            this.skip();
        }

        manager = new HSQLManager(TRANSACTION_MANAGER_TEST_CONFIG);
        await manager.initialize();
        
        // Manually create and register ConnectionManager (required dependency)
        const { ConnectionManager } = await import('../../../../src/core/modules/connection/ConnectionManager.js');
        connectionManager = new ConnectionManager();
        await connectionManager.initialize(manager);
        
        // Manually create and register TransactionManager
        const txManager = new TransactionManager();
        await txManager.initialize(manager);
        
        transactionManager = txManager;
    });

    after(async function() {
        if (transactionManager && transactionManager.isInitialized) {
            await transactionManager.destroy();
        }
        
        if (connectionManager && connectionManager.isInitialized) {
            await connectionManager.destroy();
        }
        
        if (manager) {
            await manager.destroy();
        }
        
        if (consoleSuppressor) {
            consoleSuppressor.restore();
        }
    });

    beforeEach(function() {
        // Clean up before each test
        if (transactionManager && transactionManager.isInitialized) {
            // Reset any transaction state if needed
        }
    });

    afterEach(async function() {
        // CORRECTION CRITIQUE: Nettoyage complet après chaque test
        try {
            // Forcer la libération de toutes les connexions réservées
            if (connectionManager && typeof connectionManager.forceReleaseAllConnections === 'function') {
                connectionManager.forceReleaseAllConnections();
            }
            
            // Attendre que toutes les opérations asynchrones se terminent
            await sleep(200);
            
            // Nettoyer la table de test pour éviter les conflits d'ID
            if (transactionManager && transactionManager.isInitialized) {
                try {
                    const cleanupTransaction = await transactionManager.beginTransaction();
                    try {
                        await cleanupTransaction.execute('DROP TABLE IF EXISTS TEST_TRANSACTIONS');
                        await cleanupTransaction.commit();
                    } catch (error) {
                        await cleanupTransaction.rollback('Cleanup failed');
                    }
                } catch (error) {
                    // Ignorer les erreurs de nettoyage si le manager n'est pas disponible
                }
            }
        } catch (error) {
            // Ignorer les erreurs de nettoyage pour ne pas interrompre les tests
            console.log('Warning: Cleanup error in afterEach:', error);
        }
        
        // Pause supplémentaire pour permettre le nettoyage complet
        await sleep(100);
    });

    describe('Module Initialization', function() {
        it('should create TransactionManager with correct properties', function() {
            expect(transactionManager.name).to.equal('TransactionManager');
            expect(transactionManager.version).to.equal('1.0.0');
            expect(transactionManager.isInitialized).to.be.true;
        });

        it('should have correct default configuration', function() {
            expect(DEFAULT_TRANSACTION_CONFIG.defaultIsolationLevel).to.equal(IsolationLevel.READ_COMMITTED);
            expect(DEFAULT_TRANSACTION_CONFIG.defaultTimeout).to.equal(30000);
            expect(DEFAULT_TRANSACTION_CONFIG.maxConcurrentTransactions).to.equal(100);
            expect(DEFAULT_TRANSACTION_CONFIG.enableDeadlockDetection).to.be.true;
            expect(DEFAULT_TRANSACTION_CONFIG.deadlockDetectionInterval).to.equal(5000);
            expect(DEFAULT_TRANSACTION_CONFIG.enableMetrics).to.be.true;
            expect(DEFAULT_TRANSACTION_CONFIG.savepointPrefix).to.equal('sp_');
            expect(DEFAULT_TRANSACTION_CONFIG.enableNestedTransactions).to.be.true;
        });

        it('should create manager with custom configuration', function() {
            const customConfig: TransactionConfig = {
                defaultIsolationLevel: IsolationLevel.SERIALIZABLE,
                defaultTimeout: 60000,
                maxConcurrentTransactions: 50,
                enableDeadlockDetection: false
            };
            
            const testManager = new TransactionManager(customConfig);
            expect(testManager).to.be.instanceOf(TransactionManager);
            expect(testManager.name).to.equal('TransactionManager');
        });

        it('should not allow double initialization', async function() {
            const testManager = new TransactionManager();
            await testManager.initialize(manager);
            
            try {
                await testManager.initialize(manager);
                expect.fail('Should have thrown an error');
            } catch (error: unknown) {
                expect(error).to.be.instanceOf(ModuleError);
                expect((error as Error).message).to.include('already initialized');
