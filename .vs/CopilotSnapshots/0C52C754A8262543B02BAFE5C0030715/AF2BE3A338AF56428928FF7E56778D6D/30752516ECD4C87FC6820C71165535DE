            await manager.destroy();
        }
        
        if (consoleSuppressor) {
            consoleSuppressor.restore();
        }
    });

    beforeEach(function() {
        // Clean up before each test
        if (transactionManager && transactionManager.isInitialized) {
            // Reset any transaction state if needed
        }
    });

    afterEach(async function() {
        // Force release all connections to avoid leaks
        if (connectionManager && typeof connectionManager.forceReleaseAllConnections === 'function') {
            connectionManager.forceReleaseAllConnections();
        }

        // Rollback any lingering transactions using v2.0 cleanup
        if (transactionManager && transactionManager.isInitialized && typeof (transactionManager as any).rollbackAllTransactions === 'function') {
            await (transactionManager as any).rollbackAllTransactions('Test cleanup afterEach for TransactionManager v2.0');
        }

        // Enhanced cleanup for v2.0
        try {
            if (transactionManager && transactionManager.isInitialized) {
                const cleanupContext = await transactionManager.beginTransaction();
                try {
                    await dropTestTable(cleanupContext);

                    // Discover and drop dynamically created test tables
                    const tablesResult = await cleanupContext.execute("SELECT TABLE_NAME FROM INFORMATION_SCHEMA.TABLES WHERE TABLE_SCHEMA = 'PUBLIC' AND TABLE_NAME LIKE 'TEST_DDL_%'");
                    if (tablesResult.rows) {
                        for (const row of tablesResult.rows) {
                            const tableName = Array.isArray(row) ? row[0] : (row as any).TABLE_NAME;
                            if (tableName) {
                                await cleanupContext.execute(`DROP TABLE IF EXISTS ${tableName}`);
                            }
                        }
                    }
                    
                    await cleanupContext.execute('CHECKPOINT');
                    await cleanupContext.commit();
                } catch (cleanupError) {
                    await cleanupContext.rollback('Cleanup failed');
                    console.log('Test cleanup error (Manager v2.0):', (cleanupError as Error).message);
                }
            }
        } catch (error) {
            console.log('Outer test cleanup error (Manager v2.0):', (error as Error).message);
        }
        
        await sleep(150);
    });

    describe('Module Initialization v2.0', function() {
        it('should create TransactionManager v2.0 with correct properties', function() {
            expect(transactionManager.name).to.equal('TransactionManager');
            expect(transactionManager.version).to.equal('2.0.0'); // UPDATED: v2.0.0
            expect(transactionManager.isInitialized).to.be.true;
        });

        it('should have correct v2.0 default configuration', function() {
            expect(DEFAULT_TRANSACTION_CONFIG.defaultIsolationLevel).to.equal(IsolationLevel.READ_COMMITTED);
            expect(DEFAULT_TRANSACTION_CONFIG.defaultTimeout).to.equal(30000);
            expect(DEFAULT_TRANSACTION_CONFIG.maxConcurrentTransactions).to.equal(50); // UPDATED: 50 instead of 100
            expect(DEFAULT_TRANSACTION_CONFIG.enableDeadlockDetection).to.be.true;
            expect(DEFAULT_TRANSACTION_CONFIG.deadlockDetectionInterval).to.equal(5000);
            expect(DEFAULT_TRANSACTION_CONFIG.enableMetrics).to.be.true;
            expect(DEFAULT_TRANSACTION_CONFIG.savepointPrefix).to.equal('sp_');
            expect(DEFAULT_TRANSACTION_CONFIG.enableNestedTransactions).to.be.true;
        });

        it('should create manager with custom configuration for v2.0', function() {
            const customConfig: TransactionConfig = {
                defaultIsolationLevel: IsolationLevel.SERIALIZABLE,
                defaultTimeout: 60000,
                maxConcurrentTransactions: 25, // UPDATED: Lower limit for v2.0
