                (transactionManager as any).name = 'Changed';
                (transactionManager as any).version = '3.0.0';
                
                expect(transactionManager.name).to.equal('TransactionManager');
                expect(transactionManager.version).to.equal('2.0.0'); // UPDATED: v2.0.0
                
                console.log('Module properties maintained their expected values');
            } catch (error) {
                console.log('Module properties are truly readonly');
            }
        });
    });

    describe('Transaction Lifecycle Management v2.0', function() {
        it('should begin a transaction successfully in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
            expect(transaction).to.be.instanceOf(TransactionContext);
            expect(transaction.getTransactionId()).to.be.a('string');
            expect(transaction.getTransactionId()).to.include('tx_v2_'); // UPDATED: v2.0 format
            expect(transaction.getConnection()).to.exist;
            
            const state = transaction.getState();
            expect(state.transactionId).to.equal(transaction.getTransactionId());
            expect(state.isValid).to.be.true;
            expect(state.queryCount).to.equal(0);
            expect(state.totalQueryTime).to.equal(0);
            
            await transaction.rollback('Test cleanup');
        });

        it('should commit a transaction successfully in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
            try {
                await createTestTable(transaction);
                const uniqueId = Date.now() + Math.floor(Math.random() * 100000);
                await transaction.execute('INSERT INTO TEST_TRANSACTIONS (id, value) VALUES (?, ?)', [uniqueId, 'test_v2']);
                
                await transaction.commit();
                
                // Transaction should be invalidated after commit
                const state = transaction.getState();
                expect(state.isValid).to.be.false;
                
            } catch (error) {
                await transaction.rollback('Test failed');
                throw error;
            }
        });

        it('should rollback a transaction successfully in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
            try {
                await createTestTable(transaction);
                const uniqueId = Date.now() + Math.floor(Math.random() * 10000);
                await transaction.execute('INSERT INTO TEST_TRANSACTIONS (id, value) VALUES (?, ?)', [uniqueId, 'rollback_test_v2']);
                
                await transaction.rollback('Intentional rollback');
                
                // Transaction should be invalidated after rollback
                const state = transaction.getState();
                expect(state.isValid).to.be.false;
                
            } catch (error) {
                // Rollback should not fail
                throw error;
            }
        });

        it('should generate unique transaction IDs in v2.0 format', async function() {
            const transaction1 = await transactionManager.beginTransaction();
            const transaction2 = await transactionManager.beginTransaction();
            
            expect(transaction1.getTransactionId()).to.not.equal(transaction2.getTransactionId());
            expect(transaction1.getTransactionId()).to.include('tx_v2_'); // UPDATED: v2.0 format
            expect(transaction2.getTransactionId()).to.include('tx_v2_'); // UPDATED: v2.0 format
            
            await transaction1.rollback('Test cleanup');
            await transaction2.rollback('Test cleanup');
        });

        it('should allow custom transaction IDs in v2.0', async function() {
            const customId = 'custom-transaction-id-12345';
            const transaction = await transactionManager.beginTransaction(customId);
            
            expect(transaction.getTransactionId()).to.equal(customId);
            
            await transaction.rollback('Test cleanup');
        });

        it('should handle concurrent transactions within limits in v2.0', async function() {
            const maxConcurrent = 5;
            const transactions: TransactionContext[] = [];
            
            try {
                // Create multiple concurrent transactions
                for (let i = 0; i < maxConcurrent; i++) {
                    const tx = await transactionManager.beginTransaction();
                    transactions.push(tx);
                }
                
                expect(transactionManager.getActiveTransactionCount()).to.equal(maxConcurrent);
                
            } finally {
                // Clean up all transactions
                for (const tx of transactions) {
                    try {
                        await tx.rollback('Test cleanup');
                    } catch (error) {
                        // Ignore cleanup errors
                    }
                }
            }
        });

        it('should enforce v2.0 maximum concurrent transaction limit', async function() {
            // Create a manager with very low limit for v2.0
            const limitedConfig: TransactionConfig = {
                maxConcurrentTransactions: 2
            };
            
            const limitedManager = new TransactionManager(limitedConfig);
            await limitedManager.initialize(manager);
            
            const transactions: TransactionContext[] = [];
            
            try {
                // Create transactions up to limit
                for (let i = 0; i < 2; i++) {
                    const tx = await limitedManager.beginTransaction();
                    transactions.push(tx);
                }
                
                // Next transaction should fail
                try {
                    await limitedManager.beginTransaction();
                    expect.fail('Should have thrown an error for exceeding limit');
                } catch (error: unknown) {
                    expect(error).to.be.instanceOf(ModuleError);
                    expect((error as Error).message).to.include('Maximum concurrent transactions exceeded');
                }
                
            } finally {
                // Clean up
                for (const tx of transactions) {
                    try {
                        await tx.rollback('Test cleanup');
                    } catch (error) {
                        // Ignore cleanup errors
                    }
                }
                await limitedManager.destroy();
            }
        });

        it('should handle v2.0 simplified connection management', async function() {
            // Test that v2.0 uses direct connection management without sessions
            const transaction = await transactionManager.beginTransaction();
            
            try {
                await createTestTable(transaction);
                
                // In v2.0, connections are managed directly without session tracking
                const connection = transaction.getConnection();
                expect(connection).to.exist;
                
                // Transaction should be tracked in active transactions
                const activeCount = transactionManager.getActiveTransactionCount();
                expect(activeCount).to.be.greaterThan(0);
                
                await transaction.rollback('Test cleanup');
                
                // After rollback, transaction should be cleaned up
                const finalCount = transactionManager.getActiveTransactionCount();
                expect(finalCount).to.be.lessThan(activeCount);
                
            } catch (error) {
                await transaction.rollback('Test failed');
                throw error;
            }
        });
    });

    describe('Enhanced Error Handling v2.0', function() {
        it('should handle operations before initialization in v2.0', async function() {
            const testManager = new TransactionManager();
            
            try {
                await testManager.beginTransaction();
                expect.fail('Should have thrown an error');
            } catch (error: unknown) {
                expect(error).to.be.instanceOf(ModuleError);
                expect((error as Error).message).to.include('not initialized');
            }
        });

        it('should handle invalid transaction operations in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
            try {
                await transaction.commit();
                
                // Operations after commit should fail
                try {
                    await transaction.execute('SELECT 1');
                    expect.fail('Should have thrown an error');
                } catch (error: unknown) {
                    expect(error).to.be.instanceOf(ModuleError);
                    expect((error as Error).message).to.include('Transaction context destroyed');
                }
                
            } catch (error) {
                await transaction.rollback('Test failed');
                throw error;
            }
        });

        it('should handle non-existent transaction operations in v2.0', async function() {
            try {
                await transactionManager.commitTransaction('non-existent-tx-id');
                expect.fail('Should have thrown an error');
            } catch (error: unknown) {
                expect(error).to.be.instanceOf(InactiveTransactionError);
            }
            
            try {
                await transactionManager.rollbackTransaction('non-existent-tx-id');
                expect.fail('Should have thrown an error');
            } catch (error: unknown) {
                expect(error).to.be.instanceOf(InactiveTransactionError);
            }
        });

        it('should handle savepoint errors gracefully in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
            try {
                // Try to rollback to non-existent savepoint
                try {
                    await transaction.rollbackToSavepoint('non-existent');
                    expect.fail('Should have thrown an error');
                } catch (error: unknown) {
                    expect(error).to.be.instanceOf(ModuleError);
                    expect((error as Error).message).to.include('not found');
                }
                
                // Try to release non-existent savepoint
                try {
                    await transaction.releaseSavepoint('non-existent');
                    expect.fail('Should have thrown an error');
                } catch (error: unknown) {
                    expect(error).to.be.instanceOf(ModuleError);
                    expect((error as Error).message).to.include('not found');
                }
                
                await transaction.rollback('Test cleanup');
                
            } catch (error) {
                await transaction.rollback('Test failed');
                throw error;
            }
        });

        it('should handle multiple destroy calls gracefully in v2.0', async function() {
            const testManager = new TransactionManager();
            await testManager.initialize(manager);
            
            await testManager.destroy();
            expect(testManager.isInitialized).to.be.false;
            
            // Second destroy should not throw in v2.0
            await testManager.destroy();
            expect(testManager.isInitialized).to.be.false;
        });
    });

    describe('v2.0 Performance and Stability', function() {
        it('should handle rapid transaction creation and destruction in v2.0', async function() {
            const transactionCount = 3; // Reduced for v2.0 stability
            const startTime = Date.now();
            
            // Create transactions sequentially with pauses for v2.0 stability
            for (let i = 0; i < transactionCount; i++) {
                const transaction = await transactionManager.beginTransaction();
                await transaction.rollback('Performance test v2.0');
                
                // Small pause between transactions for v2.0
                await sleep(100);
            }
            
            const duration = Date.now() - startTime;
            const transactionsPerSecond = (transactionCount / duration) * 1000;
            
            console.log(`v2.0: Created and destroyed ${transactionCount} transactions in ${duration}ms`);
            console.log(`v2.0 Rate: ${transactionsPerSecond.toFixed(2)} transactions/second`);
            
            // Should be reasonably fast in v2.0
            expect(duration).to.be.lessThan(30000);
        });

        it('should maintain v2.0 enhanced resource cleanup', async function() {
            const initialCount = transactionManager.getActiveTransactionCount();
            
            const transaction = await transactionManager.beginTransaction();
            expect(transactionManager.getActiveTransactionCount()).to.equal(initialCount + 1);
            
            await transaction.rollback('Test cleanup');
            
            // In v2.0, cleanup should be immediate and reliable
            expect(transactionManager.getActiveTransactionCount()).to.equal(initialCount);
        });

        it('should handle v2.0 concurrent transactions with improved stability', async function () {
            // Pre-create the table once for v2.0
            const prepTx = await transactionManager.beginTransaction();
            await createTestTable(prepTx);
            await prepTx.commit();

            // Reduced concurrency for v2.0 stability
            const maxConcurrent = 2;
            const txs = await Promise.all(
                Array.from({ length: maxConcurrent }, () =>
                    transactionManager.beginTransaction()
                )
            );

            try {
                // Execute operations in parallel with v2.0
                const results = await Promise.all(
                    txs.map((tx, i) =>
                        tx.execute(
                            'INSERT INTO TEST_TRANSACTIONS (id, value) VALUES (?, ?)',
                            [2000 + i, `concurrent_v2_${i}`]
                        )
                    )
                );

                expect(results).to.have.length(maxConcurrent);
            } finally {
                // v2.0 enhanced cleanup
                await Promise.all(
                    txs.map(tx => tx.rollback('Test cleanup v2.0'))
                );
            }
        });
    });

    describe('Transaction Context Operations v2.0', function() {
        it('should execute SQL statements within transaction in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
            try {
                await createTestTable(transaction);
                
                const uniqueId = Date.now() % 1000000;
                
                const insertResult = await transaction.execute(
                    'INSERT INTO TEST_TRANSACTIONS (id, value) VALUES (?, ?)',
                    [uniqueId, 'context_test_v2']
                );
                
                expect(insertResult.success).to.be.true;
                expect(insertResult.affectedRows).to.equal(1);
                expect(insertResult.executionTime).to.be.a('number');
                expect(insertResult.executionTime).to.be.greaterThanOrEqual(0);
                
                const selectResult = await transaction.query(
                    'SELECT * FROM TEST_TRANSACTIONS WHERE id = ?',
                    [uniqueId]
                );
                
                expect(selectResult).to.be.an('array');
                expect(selectResult.length).to.equal(1);
                
                // Handle both array and object formats for v2.0
                const row = selectResult[0];
                if (Array.isArray(row)) {
                    expect(row[0]).to.equal(uniqueId);
                    expect(row[1]).to.equal('context_test_v2');
                } else {
                    expect(row.ID).to.equal(uniqueId);
                    expect(row.VALUE).to.equal('context_test_v2');
                }
                
                await transaction.rollback('Test cleanup');
                
            } catch (error) {
                await transaction.rollback('Test failed');
                throw error;
            }
        });

        it('should handle batch execution in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
            try {
                await createTestTable(transaction);
                
                const baseId = Date.now() % 1000000;
                
                const batchResult = await transaction.executeBatch({
                    sql: 'INSERT INTO TEST_TRANSACTIONS (id, value) VALUES (?, ?)',
                    parameterSets: [
                        [baseId, 'batch_1'],
                        [baseId + 1, 'batch_2'],
                        [baseId + 2, 'batch_3']
                    ]
                });
                
                expect(batchResult.successCount).to.equal(3);
                expect(batchResult.failureCount).to.equal(0);
                expect(batchResult.results).to.have.length(3);
                expect(batchResult.errors).to.have.length(0);
                expect(batchResult.totalExecutionTime).to.be.a('number');
                
                await transaction.rollback('Test cleanup');
                
            } catch (error) {
                await transaction.rollback('Test failed');
                throw error;
            }
        });

        it('should create and manage savepoints in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
            try {
                await createTestTable(transaction);
                await transaction.execute('DELETE FROM TEST_TRANSACTIONS WHERE id >= 0');
                
                const baseId = Date.now() % 1000000;
                
                // Insert initial data
                await transaction.execute('INSERT INTO TEST_TRANSACTIONS (id, value) VALUES (?, ?)', [baseId, 'initial_v2']);
                
                // Create savepoint
                const savepointName = await transaction.createSavepoint('test_savepoint_v2');
                expect(savepointName).to.be.a('string');
                
                // Insert more data
                await transaction.execute('INSERT INTO TEST_TRANSACTIONS (id, value) VALUES (?, ?)', [baseId + 1, 'after_savepoint_v2']);
                
                // Check savepoints
                const savepoints = transaction.getActiveSavepoints();
                expect(savepoints).to.have.length(1);
                expect(savepoints[0].name).to.equal(savepointName);
                expect(savepoints[0].isValid).to.be.true;
                
                // Rollback to savepoint
                await transaction.rollbackToSavepoint(savepointName);
                
                // Verify data after rollback
                const data = await transaction.query('SELECT * FROM TEST_TRANSACTIONS WHERE id >= ? AND id < ?', [baseId, baseId + 10]);
                expect(data).to.have.length(1);
                
                await transaction.rollback('Test cleanup');
                
            } catch (error) {
                await transaction.rollback('Test failed');
                throw error;
            }
        });

        it('should release savepoints in v2.0', async function() {
            const transaction = await transactionManager.beginTransaction();
            
