            };
            
            const testManager = new TransactionManager(customConfig);
            expect(testManager).to.be.instanceOf(TransactionManager);
            expect(testManager.name).to.equal('TransactionManager');
        });

        it('should not allow double initialization in v2.0', async function() {
            const testManager = new TransactionManager();
