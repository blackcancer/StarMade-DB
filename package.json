{
  "name": "starmade-db",
  "version": "2.0.1",
  "description": "Unified module for interacting with StarMade's HSQLDB database via JDBC - Modular Architecture",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./hsql-manager": {
      "types": "./dist/core/HSQLManager.d.ts",
      "import": "./dist/core/HSQLManager.js"
    },
    "./modules": {
      "types": "./dist/core/modules/index.d.ts",
      "import": "./dist/core/modules/index.js"
    },
    "./interfaces": {
      "types": "./dist/core/interfaces.d.ts",
      "import": "./dist/core/interfaces.js"
    },
    "./errors": {
      "types": "./dist/core/errors.d.ts",
      "import": "./dist/core/errors.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "package.json",
    "docs/*.md",
    "docs/api/**/*.md",
    "docs/database/**/*.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "rimraf dist .tsbuildinfo && tsc",
    "build:watch": "tsc --watch",
    "build:prod": "rimraf dist .tsbuildinfo && tsc --project tsconfig.prod.json",
    "clean": "rimraf dist .tsbuildinfo",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:no-build": "node scripts/run-tests.mjs",
    "test:watch": "node scripts/run-tests.mjs --watch",
    "test:coverage": "npm run build && c8 node scripts/run-tests.mjs",
    "explore": "npm run build && node tools/StarMadeExplorer.js",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run docs:check && npm run test:coverage",
    "prepublishOnly": "npm run validate && npm run build:prod",
    "docs:check": "node scripts/check-jsdoc.mjs",
    "docs:build": "node scripts/generate-api-docs.mjs"
  },
  "keywords": [
    "starmade",
    "hsqldb",
    "jdbc",
    "database",
    "gaming",
    "space",
    "sql",
    "modular",
    "architecture",
    "performance",
    "monitoring",
    "transactions",
    "schema-analysis",
    "reporting"
  ],
  "author": "InitSysRev",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "nodejs-jdbc": "^0.1.5",
    "starmade-decoder": "file:../StarMade-Decoder",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.9",
    "@types/sinon": "^17.0.4",
    "c8": "^11.0.0",
    "chai": "^5.2.0",
    "chai-as-promised": "^8.0.1",
    "mocha": "^12.0.1",
    "rimraf": "^6.0.1",
    "sinon": "^21.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "java": "0.16.2",
    "nodejs-jdbc": {
      "java": "0.16.2",
      "uuid": "^11.1.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/InitSysRev/StarMade-DB.git"
  },
  "bugs": {
    "url": "https://github.com/InitSysRev/StarMade-DB/issues"
  },
  "homepage": "https://github.com/InitSysRev/StarMade-DB#readme",
  "c8": {
    "all": true,
    "src": [
      "src"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "reporter": [
      "text-summary",
      "json",
      "json-summary",
      "html"
    ],
    "check-coverage": true,
    "lines": 100,
    "branches": 100,
    "per-file": true
  }
}
